// Music Effect Modes
enum class MusicEffectMode {
    NORMAL, ULTRA, VINTAGE, DEEP_BASS
}

@Composable
fun FullScreenThumbnailWithGestures(
    mediaMetadata: MediaMetadata?,
    playerConnection: PlayerConnection,
    onOpenFullscreenLyrics: () -> Unit,
    onPlayPauseClick: () -> Unit,
    onShowAudioEffectsDialog: () -> Unit,
    likeButtonRefresh: Int,
    onLikeButtonRefresh: () -> Unit,
    hasActiveEffects: Boolean,
    modifier: Modifier = Modifier
) {
    val context = LocalContext.current
    var showSwipeHint by remember { mutableStateOf(false) }
    var showPlayPauseOverlay by remember { mutableStateOf(false) }

    // Get current liked status from playerConnection with null safety
    val currentSong by playerConnection.currentSong.collectAsState(initial = null)

    // Music Effect Panel State
    var showMusicEffectPanel by remember { mutableStateOf(false) }
    var currentMusicEffect by remember { mutableStateOf(MusicEffectMode.NORMAL) }
    val effectPanelOffset = remember { Animatable(0f) }

    // Double-tap to like animation state
    val coroutineScope = rememberCoroutineScope()
    val density = LocalDensity.current
    val haptic = LocalHapticFeedback.current
    var heartOffset by remember { mutableStateOf(Offset.Zero) }
    var showHeart by remember { mutableStateOf(false) }
    val heartScale = remember { Animatable(0f) }
    val heartAlpha = remember { Animatable(1f) }
    val heartSize = 120.dp

    // Enhanced particle effects
    var showParticles by remember { mutableStateOf(false) }
    val particleScale = remember { Animatable(0f) }
    val particleAlpha = remember { Animatable(0f) }

    // Smooth song transition state
    var isTransitioning by remember { mutableStateOf(false) }
    val transitionOffset = remember { Animatable(0f) }
    val transitionAlpha = remember { Animatable(1f) }

    Box(
        modifier = modifier
            .pointerInput(Unit) {
                detectTapGestures(
                    onTap = { offset ->
                        try {
                            // Check if tap is in seekbar area - if so, don't handle it
                            val screenHeight = size.height
                            val seekbarAreaTop = screenHeight - 300.dp.toPx() // Increased seekbar area exclusion
                            
                            if (offset.y < seekbarAreaTop) {
                                // Single tap for play/pause with visual feedback (only if not in seekbar area)
                                onPlayPauseClick()
                                showPlayPauseOverlay = true
                            }
                        } catch (e: Exception) {
                            android.util.Log.e("Player", "Error in tap gesture", e)
                        }
                    },
                    onDoubleTap = { offset ->
                        try {
                            android.util.Log.d("Player", "Double tap gesture detected at: $offset")
                            // Check if tap is in seekbar area - if so, don't handle it
                            val screenHeight = size.height
                            val seekbarAreaTop = screenHeight - 300.dp.toPx() // Increased seekbar area exclusion
                            
                            android.util.Log.d("Player", "Screen height: $screenHeight, Seekbar area top: $seekbarAreaTop, Tap Y: ${offset.y}")
                            
                            if (offset.y < seekbarAreaTop) {
                                // Double tap: like with Instagram-style heart animation (only if not in seekbar area)
                                heartOffset = offset
                                
                                // Always show heart animation on double tap, regardless of current like status
                                showHeart = true
                                showParticles = true
                                
                                // Visual feedback - show toast or log
                                android.util.Log.d("Player", "Heart animation triggered by double tap")
                                
                                // Double tap: Only like (never unlike) + show animation
                                android.util.Log.d("Player", "Double tap detected - liking song")
                                android.util.Log.d("Player", "Current song liked status: ${currentSong?.song?.liked}")
                                // Only like if not already liked
                                if (currentSong?.song?.liked != true) {
                                    android.util.Log.d("Player", "Liking song via double tap")
                                    playerConnection.toggleLike()
                                    // Force refresh like button
                                    onLikeButtonRefresh()
                                } else {
                                    android.util.Log.d("Player", "Song already liked, showing animation only")
                                }
                                
                                // Add haptic feedback for double tap
                                haptic.performHapticFeedback(HapticFeedbackType.LongPress)

                                coroutineScope.launch {
                                    // Instagram-style heart animation
                                    heartScale.snapTo(0f)
                                    heartAlpha.snapTo(1f)
                                    
                                    // Bounce animation like Instagram
                                    heartScale.animateTo(
                                        targetValue = 1.5f,
                                        animationSpec = spring(
                                            dampingRatio = Spring.DampingRatioMediumBouncy,
                                            stiffness = Spring.StiffnessLow
                                        )
                                    )
                                    
                                    // Settle back to normal size
                                    heartScale.animateTo(1f, animationSpec = tween(150))

                                    // Particle effects around heart
                                    particleScale.snapTo(0f)
                                    particleAlpha.snapTo(1f)
                                    particleScale.animateTo(
                                        targetValue = 1.3f,
                                        animationSpec = spring(
                                            dampingRatio = Spring.DampingRatioLowBouncy,
                                            stiffness = Spring.StiffnessVeryLow
                                        )
                                    )

                                    // Keep visible briefly then fade out
                                    delay(800)
                                    heartAlpha.animateTo(0f, animationSpec = tween(300))
                                    particleAlpha.animateTo(0f, animationSpec = tween(400))
                                    showHeart = false
                                    showParticles = false
                                }
                            }
                        } catch (e: Exception) {
                            android.util.Log.e("Player", "Error in double tap gesture", e)
                        }
                    },
                    onLongPress = { offset ->
                        try {
                            // Check if tap is in seekbar area - if so, don't handle it
                            val screenHeight = size.height
                            val seekbarAreaTop = screenHeight - 300.dp.toPx() // Increased seekbar area exclusion
                            
                            if (offset.y < seekbarAreaTop) {
                                // Long press for lyrics (only if not in seekbar area)
                                onOpenFullscreenLyrics()
                            }
                        } catch (e: Exception) {
                            android.util.Log.e("Player", "Error in long press gesture", e)
                        }
                    }
                )
            }
            .pointerInput(Unit) {
                detectHorizontalDragGestures(
                    onDragStart = { },
                    onDragEnd = { },
                    onHorizontalDrag = { change, dragAmount ->
                        try {
                            // Check if drag is in seekbar area - if so, don't handle it
                            val screenHeight = size.height
                            val seekbarAreaTop = screenHeight - 300.dp.toPx() // Increased seekbar area exclusion
                            
                            if (change.position.y < seekbarAreaTop) {
                                // Only handle swipe LEFT (negative dragAmount)
                                if (dragAmount < -50f) {
                                    // Consume the event to prevent conflicts
                                    change.consume()
                                    // Swipe left to show audio effects dialog
                                    android.util.Log.d("AudioEffects", "Swipe left detected")
                                    onShowAudioEffectsDialog()
                                }
                                // Swipe right is ignored - no action needed
                            }
                        } catch (e: Exception) {
                            android.util.Log.e("Player", "Error in horizontal drag gesture", e)
                        }
                    }
                )
            }
            .pointerInput(Unit) {
                detectVerticalDragGestures { change, dragAmount ->
                    try {
                        // Check if drag is in seekbar area - if so, don't handle it
                        val screenHeight = size.height
                        val seekbarAreaTop = screenHeight - 300.dp.toPx() // Increased seekbar area exclusion
                        
                        if (change.position.y < seekbarAreaTop) {
                            // Smooth swipe detection
                            val absoluteDrag = kotlin.math.abs(dragAmount)

                            // Use a smoother threshold
                            if (absoluteDrag > 80f) {
                                if (dragAmount > 0) {
                                    // Swipe down - previous song
                                    if (playerConnection.canSkipPrevious.value) {
                                        playerConnection.seekToPrevious()
                                        showSwipeHint = true
                                    }
                                } else {
                                    // Swipe up - next song
                                    if (playerConnection.canSkipNext.value) {
                                        playerConnection.seekToNext()
                                        showSwipeHint = true
                                    }
                                }
                                // Consume the drag to prevent multiple triggers
                                change.consume()
                            }
                        }
                    } catch (e: Exception) {
                        android.util.Log.e("Player", "Error in vertical drag gesture", e)
                    }
                }
            }
    ) {
        // Full screen background thumbnail - covers entire area
        AsyncImage(
            model = mediaMetadata?.thumbnailUrl,
            contentDescription = null,
            contentScale = ContentScale.Crop,
            modifier = Modifier
                .fillMaxSize()
        )

        // Dark overlay to make controls more readable
        Box(
            modifier = Modifier
                .fillMaxSize()
                .background(
                    Brush.verticalGradient(
                        colors = listOf(
                            Color.Transparent,
                            Color.Black.copy(alpha = 0.8f)
                        ),
                        startY = 0f,
                        endY = Float.POSITIVE_INFINITY
                    )
                )
        )

        // Play/Pause overlay icon that appears on tap
        AnimatedVisibility(
            visible = showPlayPauseOverlay,
            enter = fadeIn(tween(150)),
            exit = fadeOut(tween(400))
        ) {
            LaunchedEffect(showPlayPauseOverlay) {
                if (showPlayPauseOverlay) {
                    delay(800)
                    showPlayPauseOverlay = false
                }
            }

            Box(
                modifier = Modifier
                    .fillMaxSize()
                    .background(Color.Black.copy(alpha = 0.4f)),
                contentAlignment = Alignment.Center
            ) {
                val isPlaying by playerConnection.isPlaying.collectAsState()
                val playbackState by playerConnection.playbackState.collectAsState()

                Image(
                    painter = painterResource(
                        if (playbackState == STATE_ENDED) {
                            R.drawable.replay
                        } else if (isPlaying) {
                            R.drawable.pause
                        } else {
                            R.drawable.play
                        }
                    ),
                    contentDescription = if (isPlaying) "Pause" else "Play",
                    colorFilter = ColorFilter.tint(Color.White),
                    modifier = Modifier.size(70.dp)
                )
            }
        }

        // Smooth swipe hints
        AnimatedVisibility(
            visible = showSwipeHint,
            enter = fadeIn(tween(250)),
            exit = fadeOut(tween(400))
        ) {
            LaunchedEffect(showSwipeHint) {
                if (showSwipeHint) {
                    delay(1500)
                    showSwipeHint = false
                }
            }

            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(32.dp),
                verticalArrangement = Arrangement.SpaceBetween,
                horizontalAlignment = Alignment.CenterHorizontally
            ) {
                // Top hint for previous song
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.Center
                ) {
                    Icon(
                        painter = painterResource(R.drawable.skip_previous),
                        contentDescription = null,
                        tint = Color.White,
                        modifier = Modifier.size(22.dp)
                    )
                    Spacer(Modifier.width(8.dp))
                    Text(
                        text = "Swipe down for previous",
                        color = Color.White,
                        style = MaterialTheme.typography.bodySmall
                    )
                }

                // Center hint for lyrics and play/pause
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    Text(
                        text = "Tap for play/pause",
                        color = Color.White,
                        style = MaterialTheme.typography.bodySmall
                    )
                    Spacer(Modifier.height(6.dp))
                    Text(
                        text = "Long press for lyrics",
                        color = Color.White.copy(alpha = 0.8f),
                        style = MaterialTheme.typography.bodySmall
                    )
                }

                // Bottom hint for next song
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.Center
                ) {
                    Text(
                        text = "Swipe up for next",
                        color = Color.White,
                        style = MaterialTheme.typography.bodySmall
                    )
                    Spacer(Modifier.width(8.dp))
                    Icon(
                        painter = painterResource(R.drawable.skip_next),
                        contentDescription = null,
                        tint = Color.White,
                        modifier = Modifier.size(22.dp)
                    )
                }
            }
        }

        // Instagram-style heart animation on double tap
        if (showHeart) {
            // Convert pixel offset to Dp
            val xDp = with(density) { heartOffset.x.toDp() }
            val yDp = with(density) { heartOffset.y.toDp() }

            // Main heart with Instagram-style styling
            Icon(
                imageVector = Icons.Filled.Favorite,
                contentDescription = null,
                tint = Color(0xFFFF0050), // Instagram pink color
                modifier = Modifier
                    .size(heartSize)
                    .offset(x = xDp - heartSize / 2, y = yDp - heartSize / 2)
                    .scale(heartScale.value)
                    .alpha(heartAlpha.value)
            )
            
            // Glow effect behind heart
            Icon(
                imageVector = Icons.Filled.Favorite,
                contentDescription = null,
                tint = Color(0xFFFF0050).copy(alpha = 0.3f),
                modifier = Modifier
                    .size(heartSize * 1.2f)
                    .offset(x = xDp - (heartSize * 1.2f) / 2, y = yDp - (heartSize * 1.2f) / 2)
                    .scale(heartScale.value * 0.8f)
                    .alpha(heartAlpha.value * 0.5f)
            )
        }

        // Instagram-style particle effects around heart
        if (showParticles) {
            val xDp = with(density) { heartOffset.x.toDp() }
            val yDp = with(density) { heartOffset.y.toDp() }

            // Create multiple heart particles around the main heart
            repeat(12) { index ->
                val angle = (index * 30f) * (Math.PI / 180f)
                val radius = 80.dp * particleScale.value
                val particleX = xDp + (radius * kotlin.math.cos(angle.toDouble()).toFloat())
                val particleY = yDp + (radius * kotlin.math.sin(angle.toDouble()).toFloat())

                // Instagram-style heart particles
                Icon(
                    imageVector = Icons.Filled.Favorite,
                    contentDescription = null,
                    tint = Color(0xFFFF0050).copy(alpha = particleAlpha.value),
                    modifier = Modifier
                        .size(12.dp)
                        .offset(x = particleX - 6.dp, y = particleY - 6.dp)
                        .scale(particleScale.value * 0.5f)
                )
            }
            
            // Additional sparkle effects
            repeat(6) { index ->
                val angle = (index * 60f) * (Math.PI / 180f)
                val radius = 100.dp * particleScale.value
                val particleX = xDp + (radius * kotlin.math.cos(angle.toDouble()).toFloat())
                val particleY = yDp + (radius * kotlin.math.sin(angle.toDouble()).toFloat())

                Box(
                    modifier = Modifier
                        .size(6.dp)
                        .offset(x = particleX - 3.dp, y = particleY - 3.dp)
                        .background(
                            color = Color.White.copy(alpha = particleAlpha.value),
                            shape = RoundedCornerShape(3.dp)
                        )
                        .scale(particleScale.value * 0.8f)
                )
            }
        }

        // Music Effect Panel - Swipe Left
        if (showMusicEffectPanel) {
            MusicEffectPanel(
                currentEffect = currentMusicEffect,
                onEffectSelected = { effect: MusicEffectMode ->
                    currentMusicEffect = effect
                },
                onClose = {
                    showMusicEffectPanel = false
                },
                modifier = Modifier.fillMaxSize()
            )
        }

        // Audio Effects Animation - passed from parent
        if (hasActiveEffects) {
        AnimatedVisibility(
            visible = hasActiveEffects,
                enter = fadeIn(animationSpec = tween(200, easing = FastOutSlowInEasing)),
                exit = fadeOut(animationSpec = tween(150, easing = FastOutSlowInEasing))
        ) {
            AudioEffectsAnimation(
                mediaMetadata = mediaMetadata,
                isPlaying = playerConnection.isPlaying.collectAsState().value,
                modifier = Modifier.fillMaxSize()
            )
            }
        }
    }
}

@Composable
fun MusicEffectPanel(
    currentEffect: MusicEffectMode,
    onEffectSelected: (MusicEffectMode) -> Unit,
    onClose: () -> Unit,
    modifier: Modifier = Modifier
) {
    Box(
        modifier = modifier
            .background(
                brush = Brush.verticalGradient(
                    colors = listOf(
                        Color.Black.copy(alpha = 0.9f),
                        Color.Black.copy(alpha = 0.7f)
                    )
                )
            )
            .clickable { onClose() }
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(32.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            Text(
                text = "Music Effects",
                style = MaterialTheme.typography.headlineMedium,
                color = Color.White,
                fontWeight = FontWeight.Bold
            )

            Spacer(modifier = Modifier.height(32.dp))

            // Effect options
            val effects = listOf(
                MusicEffectMode.NORMAL to "🎵 Normal Mode",
                MusicEffectMode.ULTRA to "🎧 Ultra Music Mode",
                MusicEffectMode.VINTAGE to "📻 Old Style / 90s Mode",
                MusicEffectMode.DEEP_BASS to "🔊 Deep Bass Mode"
            )

            effects.forEach { (effect, label) ->
                val isSelected = currentEffect == effect

                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(vertical = 8.dp)
                        .background(
                            color = if (isSelected)
                                MaterialTheme.colorScheme.primary.copy(alpha = 0.3f)
                            else Color.Transparent,
                            shape = RoundedCornerShape(12.dp)
                        )
                        .clickable { onEffectSelected(effect) }
                        .padding(16.dp)
                ) {
                    Row(
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(16.dp)
                    ) {
                        Text(
                            text = label,
                            style = MaterialTheme.typography.bodyLarge,
                            color = if (isSelected)
                                MaterialTheme.colorScheme.primary
                            else Color.White
                        )

                        if (isSelected) {
                            Icon(
                                painter = painterResource(R.drawable.check),
                                contentDescription = "Selected",
                                tint = MaterialTheme.colorScheme.primary,
                                modifier = Modifier.size(20.dp)
                            )
                        }
                    }
                }
            }

            Spacer(modifier = Modifier.height(32.dp))

            Text(
                text = "Swipe right to close",
                style = MaterialTheme.typography.bodySmall,
                color = Color.White.copy(alpha = 0.7f)
            )
        }
    }
}

@Composable
fun AudioEffectsSlidePanel(
    bassBoostLevel: Float,
    onBassBoostChange: (Float) -> Unit,
    threeDEffectEnabled: Boolean,
    onThreeDEffectToggle: (Boolean) -> Unit,
    reverbEnabled: Boolean,
    onReverbToggle: (Boolean) -> Unit,
    bassLevel: Float,
    onBassLevelChange: (Float) -> Unit,
    midLevel: Float,
    onMidLevelChange: (Float) -> Unit,
    trebleLevel: Float,
    onTrebleLevelChange: (Float) -> Unit,
    loudnessGain: Float,
    onLoudnessGainChange: (Float) -> Unit,
    echoStrength: Float,
    onEchoStrengthChange: (Float) -> Unit,
    onResetAll: () -> Unit,
    onClose: () -> Unit,
    onApply: () -> Unit
) {
    // Premium animations
    val scale by animateFloatAsState(
        targetValue = 1f,
        animationSpec = spring(
            dampingRatio = Spring.DampingRatioMediumBouncy,
            stiffness = Spring.StiffnessLow
        ),
        label = "dialog_scale"
    )

    val alpha by animateFloatAsState(
        targetValue = 1f,
        animationSpec = tween(300, easing = FastOutSlowInEasing),
        label = "dialog_alpha"
    )

    // Debug: Log to see if dialog is being created
    android.util.Log.d("AudioEffects", "AudioEffectsSlidePanel: Creating dialog")

    Dialog(
        onDismissRequest = onClose,
        properties = DialogProperties(
            dismissOnBackPress = true,
            dismissOnClickOutside = true,
            usePlatformDefaultWidth = false
        )
    ) {
        // Simple dialog without complex animations
        Surface(
            modifier = Modifier
                .fillMaxWidth(0.95f)
                .fillMaxHeight(0.85f)
                .scale(scale)
                .alpha(alpha),
            shape = RoundedCornerShape(24.dp),
            color = MaterialTheme.colorScheme.surface,
            shadowElevation = 16.dp
        ) {
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(24.dp),
                verticalArrangement = Arrangement.spacedBy(20.dp)
            ) {
                // Premium Header with gradient
                Row(
                    modifier = Modifier
                        .fillMaxWidth()
                        .background(
                            brush = Brush.horizontalGradient(
                                colors = listOf(
                                    MaterialTheme.colorScheme.primary.copy(alpha = 0.1f),
                                    MaterialTheme.colorScheme.secondary.copy(alpha = 0.1f)
                                )
                            ),
                            shape = RoundedCornerShape(16.dp)
                        )
                        .padding(16.dp),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Row(
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(12.dp)
                    ) {
                        Icon(
                            painter = painterResource(R.drawable.equalizer),
                            contentDescription = null,
                            tint = MaterialTheme.colorScheme.primary,
                            modifier = Modifier.size(28.dp)
                        )
                        Text(
                            text = "Audio Effects",
                            style = MaterialTheme.typography.headlineMedium,
                            fontWeight = FontWeight.Bold,
                            color = MaterialTheme.colorScheme.onSurface
                        )
                    }

                    IconButton(
                        onClick = onClose,
                        modifier = Modifier
                            .background(
                                MaterialTheme.colorScheme.error.copy(alpha = 0.1f),
                                shape = RoundedCornerShape(8.dp)
                            )
                    ) {
                        Icon(
                            painter = painterResource(R.drawable.close),
                            contentDescription = "Close",
                            tint = MaterialTheme.colorScheme.error,
                            modifier = Modifier.size(20.dp)
                        )
                    }
                }

                // Scrollable Audio Effects Content with premium styling
                Column(
                    modifier = Modifier
                        .weight(1f)
                        .verticalScroll(rememberScrollState())
                        .background(
                            MaterialTheme.colorScheme.surfaceContainer.copy(alpha = 0.5f),
                            shape = RoundedCornerShape(16.dp)
                        )
                        .padding(16.dp),
                    verticalArrangement = Arrangement.spacedBy(20.dp)
                ) {
                    AudioEffectsContent(
                        bassBoostLevel = bassBoostLevel,
                        onBassBoostChange = onBassBoostChange,
                        threeDEffectEnabled = threeDEffectEnabled,
                        onThreeDEffectToggle = onThreeDEffectToggle,
                        reverbEnabled = reverbEnabled,
                        onReverbToggle = onReverbToggle,
                        bassLevel = bassLevel,
                        onBassLevelChange = onBassLevelChange,
                        midLevel = midLevel,
                        onMidLevelChange = onMidLevelChange,
                        trebleLevel = trebleLevel,
                        onTrebleLevelChange = onTrebleLevelChange,
                        loudnessGain = loudnessGain,
                        onLoudnessGainChange = onLoudnessGainChange,
                        echoStrength = echoStrength,
                        onEchoStrengthChange = onEchoStrengthChange,
                        onResetAll = onResetAll
                    )
                }

                // Premium Bottom Buttons with animations
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(12.dp)
                ) {
                    // Close Button
                    OutlinedButton(
                        onClick = onClose,
                        modifier = Modifier
                            .weight(1f)
                            .height(48.dp),
                        colors = ButtonDefaults.outlinedButtonColors(
                            contentColor = MaterialTheme.colorScheme.onSurface
                        ),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Text(
                            text = "Close",
                            fontWeight = FontWeight.Medium
                        )
                    }

                    // Reset Button
                    OutlinedButton(
                        onClick = onResetAll,
                        modifier = Modifier
                            .weight(1f)
                            .height(48.dp),
                        colors = ButtonDefaults.outlinedButtonColors(
                            contentColor = MaterialTheme.colorScheme.error
                        ),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Text(
                            text = "Reset",
                            fontWeight = FontWeight.Medium
                        )
                    }

                    // Apply Button with gradient
                    Button(
                        onClick = onApply,
                        modifier = Modifier
                            .weight(1f)
                            .height(48.dp),
                        colors = ButtonDefaults.buttonColors(
                            containerColor = MaterialTheme.colorScheme.primary,
                            contentColor = MaterialTheme.colorScheme.onPrimary
                        ),
                        shape = RoundedCornerShape(12.dp)
                    ) {
                        Text(
                            text = "Apply",
                            fontWeight = FontWeight.Bold
                        )
                    }
                }
            }
        }
    }
}

@Composable
fun AudioEffectsContent(
    bassBoostLevel: Float,
    onBassBoostChange: (Float) -> Unit,
    threeDEffectEnabled: Boolean,
    onThreeDEffectToggle: (Boolean) -> Unit,
    reverbEnabled: Boolean,
    onReverbToggle: (Boolean) -> Unit,
    bassLevel: Float,
    onBassLevelChange: (Float) -> Unit,
    midLevel: Float,
    onMidLevelChange: (Float) -> Unit,
    trebleLevel: Float,
    onTrebleLevelChange: (Float) -> Unit,
    loudnessGain: Float,
    onLoudnessGainChange: (Float) -> Unit,
    echoStrength: Float,
    onEchoStrengthChange: (Float) -> Unit,
    onResetAll: () -> Unit
) {

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .verticalScroll(rememberScrollState()),
        verticalArrangement = Arrangement.spacedBy(16.dp)
    ) {
        // Bass Boost Section
        AudioEffectSlider(
            title = "Bass Boost",
            value = bassBoostLevel,
            onValueChange = onBassBoostChange,
            valueRange = 0f..100f,
            unit = "%"
        )

        // 3D Music Section
        AudioEffectToggle(
            title = "3D Music",
            subtitle = "Spatial audio effect",
            checked = threeDEffectEnabled,
            onCheckedChange = onThreeDEffectToggle
        )

        // Equalizer Section
        Text(
            text = "Equalizer",
            style = MaterialTheme.typography.titleMedium,
            color = MaterialTheme.colorScheme.onSurface,
            fontWeight = FontWeight.SemiBold
        )

        // Bass (60 Hz)
        AudioEffectSlider(
            title = "Bass (60 Hz)",
            value = bassLevel,
            onValueChange = onBassLevelChange,
            valueRange = -12f..12f,
            unit = "dB"
        )

        // Mid (1 kHz)
        AudioEffectSlider(
            title = "Mid (1 kHz)",
            value = midLevel,
            onValueChange = onMidLevelChange,
            valueRange = -12f..12f,
            unit = "dB"
        )

        // Treble (14 kHz)
        AudioEffectSlider(
            title = "Treble (14 kHz)",
            value = trebleLevel,
            onValueChange = onTrebleLevelChange,
            valueRange = -12f..12f,
            unit = "dB"
        )

        // Reverb Section
        AudioEffectToggle(
            title = "Reverb",
            subtitle = "Room acoustics effect",
            checked = reverbEnabled,
            onCheckedChange = onReverbToggle
        )

        // Loudness Enhancer
        AudioEffectSlider(
            title = "Loudness Boost",
            value = loudnessGain,
            onValueChange = onLoudnessGainChange,
            valueRange = 0f..100f,
            unit = "%"
        )

        // Echo Effect
        AudioEffectSlider(
            title = "Echo",
            value = echoStrength,
            onValueChange = onEchoStrengthChange,
            valueRange = 0f..100f,
            unit = "%"
        )

        // Reset Button
        Button(
            onClick = onResetAll,
            modifier = Modifier.fillMaxWidth(),
            colors = ButtonDefaults.buttonColors(
                containerColor = MaterialTheme.colorScheme.secondary
            )
        ) {
            Text("Reset All Effects")
        }
    }
}

@Composable
fun AudioEffectSlider(
    title: String,
    value: Float,
    onValueChange: (Float) -> Unit,
    valueRange: ClosedFloatingPointRange<Float>,
    unit: String,
    modifier: Modifier = Modifier
) {
    val infiniteTransition = rememberInfiniteTransition(label = "slider_$title")
    val pulseAnimation by infiniteTransition.animateFloat(
        initialValue = 0.95f,
        targetValue = 1.05f,
        animationSpec = infiniteRepeatable(
            animation = tween(1500, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "pulse"
    )

    val scaleAnimation by animateFloatAsState(
        targetValue = if (value > 0) 1.02f else 1f,
        animationSpec = spring(
            dampingRatio = DampingRatioMediumBouncy,
            stiffness = StiffnessLow
        ),
        label = "scale"
    )

    val alphaAnimation by animateFloatAsState(
        targetValue = if (value > 0) 1f else 0.7f,
        animationSpec = tween(300),
        label = "alpha"
    )

    AnimatedVisibility(
        visible = true,
        enter = slideInHorizontally(
            initialOffsetX = { it / 2 },
            animationSpec = spring(
                dampingRatio = DampingRatioMediumBouncy,
                stiffness = StiffnessLow
            )
        ) + fadeIn(animationSpec = tween(400))
    ) {
        Column(
            modifier = modifier
                .fillMaxWidth()
                .scale(scaleAnimation)
                .alpha(alphaAnimation)
        ) {
            Row(
                verticalAlignment = Alignment.CenterVertically,
                modifier = Modifier.padding(bottom = 8.dp)
            ) {
                // Animated icon based on effect type
                val primaryColor = MaterialTheme.colorScheme.primary
                Canvas(
                    modifier = Modifier
                        .size(20.dp)
                        .padding(end = 8.dp)
                ) {
                    val centerX = size.width / 2
                    val centerY = size.height / 2
                    val radius = size.minDimension / 3

                    when {
                        title.contains("Bass") -> {
                            // Bass icon - circle with waves
                            drawCircle(
                                color = primaryColor,
                                radius = radius * pulseAnimation,
                                center = androidx.compose.ui.geometry.Offset(centerX, centerY)
                            )
                            for (i in 1..3) {
                                drawCircle(
                                    color = primaryColor.copy(alpha = 0.3f / i),
                                    radius = radius * (1f + i * 0.3f) * pulseAnimation,
                                    center = androidx.compose.ui.geometry.Offset(centerX, centerY),
                                    style = Stroke(width = 2.dp.toPx())
                                )
                            }
                        }

                        title.contains("3D") -> {
                            // 3D icon - cube
                            val cubeSize = radius * 1.5f
                            drawRect(
                                color = primaryColor,
                                topLeft = androidx.compose.ui.geometry.Offset(
                                    centerX - cubeSize / 2,
                                    centerY - cubeSize / 2
                                ),
                                size = androidx.compose.ui.geometry.Size(cubeSize, cubeSize)
                            )
                        }

                        title.contains("Reverb") -> {
                            // Reverb icon - sound waves
                            for (i in 0..2) {
                                val waveRadius = radius * (1f + i * 0.5f) * pulseAnimation
                                drawCircle(
                                    color = primaryColor.copy(alpha = 0.4f),
                                    radius = waveRadius,
                                    center = androidx.compose.ui.geometry.Offset(centerX, centerY),
                                    style = Stroke(width = 2.dp.toPx())
                                )
                            }
                        }

                        else -> {
                            // Default icon - equalizer bars
                            val barWidth = size.width / 4f
                            for (i in 0..3) {
                                val barHeight =
                                    radius * (0.5f + pulseAnimation * 0.5f * (i + 1) / 4f)
                                drawRect(
                                    color = primaryColor,
                                    topLeft = androidx.compose.ui.geometry.Offset(i * barWidth, centerY - barHeight / 2),
                                    size = androidx.compose.ui.geometry.Size(barWidth * 0.8f, barHeight)
                                )
                            }
                        }
                    }
                }

                Text(
                    text = title,
                    style = MaterialTheme.typography.titleMedium,
                    color = MaterialTheme.colorScheme.onSurface,
                    fontWeight = FontWeight.SemiBold
                )
            }

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = "${valueRange.start.toInt()}$unit",
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                    style = MaterialTheme.typography.bodySmall
                )

                Slider(
                    value = value,
                    onValueChange = onValueChange,
                    valueRange = valueRange,
                    modifier = Modifier.weight(1f).padding(horizontal = 16.dp),
                    colors = SliderDefaults.colors(
                        thumbColor = MaterialTheme.colorScheme.primary,
                        activeTrackColor = MaterialTheme.colorScheme.primary,
                        inactiveTrackColor = MaterialTheme.colorScheme.onSurfaceVariant.copy(
                            alpha = 0.3f
                        )
                    )
                )

                AnimatedContent(
                    targetState = value.toInt(),
                    transitionSpec = {
                        slideInHorizontally() + fadeIn() togetherWith slideOutHorizontally() + fadeOut()
                    },
                    label = "value_display"
                ) { animatedValue ->
                    Text(
                        text = "$animatedValue$unit",
                        color = MaterialTheme.colorScheme.primary,
                        style = MaterialTheme.typography.bodySmall,
                        fontWeight = FontWeight.Medium
                    )
                }
            }
        }
    }
}

@Composable
fun AudioEffectToggle(
    title: String,
    subtitle: String,
    checked: Boolean,
    onCheckedChange: (Boolean) -> Unit,
    modifier: Modifier = Modifier
) {
    val infiniteTransition = rememberInfiniteTransition(label = "toggle_$title")
    val pulseAnimation by infiniteTransition.animateFloat(
        initialValue = 0.95f,
        targetValue = 1.05f,
        animationSpec = infiniteRepeatable(
            animation = tween(2000, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "pulse"
    )

    val scaleAnimation by animateFloatAsState(
        targetValue = if (checked) 1.05f else 1f,
        animationSpec = spring(
            dampingRatio = DampingRatioMediumBouncy,
            stiffness = StiffnessLow
        ),
        label = "scale"
    )

    val alphaAnimation by animateFloatAsState(
        targetValue = if (checked) 1f else 0.7f,
        animationSpec = tween(300),
        label = "alpha"
    )

    AnimatedVisibility(
        visible = true,
        enter = slideInHorizontally(
            initialOffsetX = { it / 2 },
            animationSpec = spring(
                dampingRatio = DampingRatioMediumBouncy,
                stiffness = StiffnessLow
            )
        ) + fadeIn(animationSpec = tween(400))
    ) {
        Row(
            modifier = modifier
                .fillMaxWidth()
                .scale(scaleAnimation)
                .alpha(alphaAnimation),
            horizontalArrangement = Arrangement.SpaceBetween,
            verticalAlignment = Alignment.CenterVertically
        ) {
            Row(
                verticalAlignment = Alignment.CenterVertically
            ) {
                // Animated icon based on effect type
                val primaryColor = MaterialTheme.colorScheme.primary
                val surfaceVariantColor = MaterialTheme.colorScheme.onSurfaceVariant
                Canvas(
                    modifier = Modifier
                        .size(20.dp)
                        .padding(end = 8.dp)
                ) {
                    val centerX = size.width / 2
                    val centerY = size.height / 2
                    val radius = size.minDimension / 3

                    when {
                        title.contains("3D") -> {
                            // 3D icon - animated cube
                            val cubeSize = radius * 1.5f * pulseAnimation
                            drawRect(
                                color = if (checked) primaryColor else surfaceVariantColor,
                                topLeft = androidx.compose.ui.geometry.Offset(
                                    centerX - cubeSize / 2,
                                    centerY - cubeSize / 2
                                ),
                                size = androidx.compose.ui.geometry.Size(cubeSize, cubeSize)
                            )
                        }

                        title.contains("Reverb") -> {
                            // Reverb icon - animated sound waves
                            for (i in 0..2) {
                                val waveRadius = radius * (1f + i * 0.5f) * pulseAnimation
                                drawCircle(
                                    color = if (checked) primaryColor else surfaceVariantColor,
                                    radius = waveRadius,
                                    center = androidx.compose.ui.geometry.Offset(centerX, centerY),
                                    style = Stroke(width = 2.dp.toPx())
                                )
                            }
                        }

                        else -> {
                            // Default icon - animated equalizer bars
                            val barWidth = size.width / 4f
                            for (i in 0..3) {
                                val barHeight =
                                    radius * (0.5f + pulseAnimation * 0.5f * (i + 1) / 4f)
                                drawRect(
                                    color = if (checked) primaryColor else surfaceVariantColor,
                                    topLeft = androidx.compose.ui.geometry.Offset(i * barWidth, centerY - barHeight / 2),
                                    size = androidx.compose.ui.geometry.Size(barWidth * 0.8f, barHeight)
                                )
                            }
                        }
                    }
                }

                Column {
                    Text(
                        text = title,
                        style = MaterialTheme.typography.titleMedium,
                        color = if (checked) MaterialTheme.colorScheme.primary else MaterialTheme.colorScheme.onSurface,
                        fontWeight = FontWeight.SemiBold
                    )
                    Text(
                        text = subtitle,
                        style = MaterialTheme.typography.bodySmall,
                        color = MaterialTheme.colorScheme.onSurfaceVariant
                    )
                }
            }

            AnimatedContent(
                targetState = checked,
                transitionSpec = {
                    slideInHorizontally() + fadeIn() togetherWith slideOutHorizontally() + fadeOut()
                },
                label = "switch_animation"
            ) { animatedChecked ->
                Switch(
                    checked = animatedChecked,
                    onCheckedChange = onCheckedChange,
                    colors = SwitchDefaults.colors(
                        checkedThumbColor = MaterialTheme.colorScheme.primary,
                        checkedTrackColor = MaterialTheme.colorScheme.primary.copy(alpha = 0.3f),
                        uncheckedThumbColor = MaterialTheme.colorScheme.onSurfaceVariant,
                        uncheckedTrackColor = MaterialTheme.colorScheme.onSurfaceVariant.copy(
                            alpha = 0.3f
                        )
                    )
                )
            }
        }
    }
}

@OptIn(ExperimentalMaterial3Api::class)
@Composable
fun BottomSheetPlayer(
    state: BottomSheetState,
    navController: NavController,
    onOpenFullscreenLyrics: () -> Unit,
    modifier: Modifier = Modifier,
) {
    val context = LocalContext.current
    val database = LocalDatabase.current
    val menuState = LocalMenuState.current

    val clipboardManager = LocalClipboardManager.current

    val playerConnection = LocalPlayerConnection.current ?: return

    // Ensure player connection is valid
    if (playerConnection.player == null) {
        return
    }

    // Use safe preference loading with fallbacks
    val playerTextAlignment by rememberEnumPreference(
        PlayerTextAlignmentKey,
        PlayerTextAlignment.SIDED
    )

    val playerBackground by rememberEnumPreference(
        key = PlayerBackgroundStyleKey,
        defaultValue = PlayerBackgroundStyle.DEFAULT
    )

    // Force dark theme always - disable system theme detection completely
    val darkTheme by rememberEnumPreference(DarkModeKey, defaultValue = DarkMode.ON)
    val pureBlack by rememberPreference(PureBlackKey, defaultValue = false)
    // Force dark theme always - ignore system theme completely
    val useDarkTheme = remember { true }
    val onBackgroundColor = when (playerBackground) {
        PlayerBackgroundStyle.DEFAULT -> MaterialTheme.colorScheme.secondary
        else ->
            if (useDarkTheme)
                MaterialTheme.colorScheme.onSurface
            else
                MaterialTheme.colorScheme.onPrimary
    }
    // Force dark background - always use dark theme
    val useBlackBackground = remember(pureBlack) {
        pureBlack
    }
    val backgroundColor = if (useBlackBackground && state.value > state.collapsedBound) {
        lerp(MaterialTheme.colorScheme.surfaceContainer, Color.Black, state.progress)
    } else {
        MaterialTheme.colorScheme.surfaceContainer
    }

    // Use safe state collection with proper error handling
    val playbackState by playerConnection.playbackState.collectAsState()
    val isPlaying by playerConnection.isPlaying.collectAsState()
    val mediaMetadata by playerConnection.mediaMetadata.collectAsState()
    val currentSong by playerConnection.currentSong.collectAsState(initial = null)
    val automix by playerConnection.service.automixItems.collectAsState()
    val repeatMode by playerConnection.repeatMode.collectAsState()

    val canSkipPrevious by playerConnection.canSkipPrevious.collectAsState()
    val canSkipNext by playerConnection.canSkipNext.collectAsState()

    val showLyrics by rememberPreference(ShowLyricsKey, defaultValue = false)

    val sliderStyle by rememberEnumPreference(SliderStyleKey, SliderStyle.DEFAULT)

    var position by rememberSaveable(playbackState) {
        mutableLongStateOf(playerConnection.player.currentPosition)
    }
    var duration by rememberSaveable(playbackState) {
        mutableLongStateOf(playerConnection.player.duration)
    }
    var sliderPosition by remember {
        mutableStateOf<Long?>(null)
    }

    var gradientColors by remember {
        mutableStateOf<List<Color>>(emptyList())
    }

    var changeColor by remember {
        mutableStateOf(false)
    }

    // Animations for background effects
    var backgroundImageUrl by remember { mutableStateOf<String?>(null) }
    val blurRadius by animateDpAsState(
        targetValue = if (state.isExpanded && playerBackground == PlayerBackgroundStyle.BLUR) 150.dp else 0.dp,
        animationSpec = tween(durationMillis = 800, easing = FastOutSlowInEasing),
        label = "blurRadius"
    )

    val backgroundAlpha by animateFloatAsState(
        targetValue = if (state.isExpanded && playerBackground != PlayerBackgroundStyle.DEFAULT) 1f else 0f,
        animationSpec = tween(durationMillis = 600, easing = FastOutSlowInEasing),
        label = "backgroundAlpha"
    )

    val overlayAlpha by animateFloatAsState(
        targetValue = when {
            !state.isExpanded -> 0f
            playerBackground == PlayerBackgroundStyle.BLUR -> 0.3f
            playerBackground == PlayerBackgroundStyle.GRADIENT && gradientColors.size >= 2 -> 0.2f
            else -> 0f
        },
        animationSpec = tween(durationMillis = 700, easing = FastOutSlowInEasing),
        label = "overlayAlpha"
    )

    val playerButtonsStyle by rememberEnumPreference(
        key = PlayerButtonsStyleKey,
        defaultValue = PlayerButtonsStyle.DEFAULT
    )
    if (!canSkipNext && automix.isNotEmpty()) {
        playerConnection.service.addToQueueAutomix(automix[0], 0)
    }

    LaunchedEffect(mediaMetadata, playerBackground) {
        // Update image URL for smooth transitions
        backgroundImageUrl = mediaMetadata?.thumbnailUrl

        if (useBlackBackground && playerBackground != PlayerBackgroundStyle.BLUR) {
            gradientColors = listOf(Color.Black, Color.Black)
        }
        if (useBlackBackground && playerBackground != PlayerBackgroundStyle.GRADIENT) {
            gradientColors = listOf(Color.Black, Color.Black)
        } else if (playerBackground == PlayerBackgroundStyle.GRADIENT) {
            withContext(Dispatchers.IO) {
                val result =
                    (
                            ImageLoader(context)
                                .execute(
                                    ImageRequest
                                        .Builder(context)
                                        .data(mediaMetadata?.thumbnailUrl)
                                        .allowHardware(false)
                                        .build(),
                                ).drawable as? BitmapDrawable
                            )?.bitmap?.extractGradientColors()

                result?.let {
                    gradientColors = it
                }
            }
        } else {
            gradientColors = emptyList()
        }
    }

    val changeBound = state.expandedBound / 3

    val TextBackgroundColor =
        when (playerBackground) {
            PlayerBackgroundStyle.DEFAULT -> MaterialTheme.colorScheme.onBackground
            PlayerBackgroundStyle.BLUR -> Color.White
            else -> {
                val whiteContrast =
                    if (gradientColors.size >= 2) {
                        ColorUtils.calculateContrast(
                            gradientColors.first().toArgb(),
                            Color.White.toArgb(),
                        )
                    } else {
                        2.0
                    }
                val blackContrast: Double =
                    if (gradientColors.size >= 2) {
                        ColorUtils.calculateContrast(
                            gradientColors.last().toArgb(),
                            Color.Black.toArgb(),
                        )
                    } else {
                        2.0
                    }
                if (gradientColors.size >= 2 &&
                    whiteContrast < 2f &&
                    blackContrast > 2f
                ) {
                    changeColor = true
                    Color.Black
                } else if (whiteContrast > 2f && blackContrast < 2f) {
                    changeColor = true
                    Color.White
                } else {
                    changeColor = false
                    Color.White
                }
            }
        }

    val icBackgroundColor =
        when (playerBackground) {
            PlayerBackgroundStyle.DEFAULT -> MaterialTheme.colorScheme.surface
            PlayerBackgroundStyle.BLUR -> Color.Black
            else -> {
                val whiteContrast =
                    if (gradientColors.size >= 2) {
                        ColorUtils.calculateContrast(
                            gradientColors.first().toArgb(),
                            Color.White.toArgb(),
                        )
                    } else {
                        2.0
                    }
                val blackContrast: Double =
                    if (gradientColors.size >= 2) {
                        ColorUtils.calculateContrast(
                            gradientColors.last().toArgb(),
                            Color.Black.toArgb(),
                        )
                    } else {
                        2.0
                    }
                if (gradientColors.size >= 2 &&
                    whiteContrast < 2f &&
                    blackContrast > 2f
                ) {
                    changeColor = true
                    Color.White
                } else if (whiteContrast > 2f && blackContrast < 2f) {
                    changeColor = true
                    Color.Black
                } else {
                    changeColor = false
                    Color.Black
                }
            }
        }

    val (textButtonColor, iconButtonColor) = when (playerButtonsStyle) {
        PlayerButtonsStyle.DEFAULT -> Pair(TextBackgroundColor, icBackgroundColor)
        PlayerButtonsStyle.SECONDARY -> Pair(
            MaterialTheme.colorScheme.secondary,
            MaterialTheme.colorScheme.onSecondary
        )
    }

    val download by LocalDownloadUtil.current.getDownload(mediaMetadata?.id ?: "")
        .collectAsState(initial = null)

    val sleepTimerEnabled =
        remember(
            playerConnection.service.sleepTimer.triggerTime,
            playerConnection.service.sleepTimer.pauseWhenSongEnd
        ) {
            playerConnection.service.sleepTimer.isActive
        }

    var sleepTimerTimeLeft by remember {
        mutableLongStateOf(0L)
    }

    LaunchedEffect(sleepTimerEnabled) {
        if (sleepTimerEnabled) {
            while (isActive) {
                sleepTimerTimeLeft =
                    if (playerConnection.service.sleepTimer.pauseWhenSongEnd) {
                        playerConnection.player.duration - playerConnection.player.currentPosition
                    } else {
                        playerConnection.service.sleepTimer.triggerTime - System.currentTimeMillis()
                    }
                delay(1000L)
            }
        }
    }

    var showSleepTimerDialog by remember {
        mutableStateOf(false)
    }

    var sleepTimerValue by remember {
        mutableFloatStateOf(30f)
    }
    if (showSleepTimerDialog) {
        AlertDialog(
            properties = DialogProperties(usePlatformDefaultWidth = false),
            onDismissRequest = { showSleepTimerDialog = false },
            icon = {
                Icon(
                    painter = painterResource(R.drawable.bedtime),
                    contentDescription = null
                )
            },
            title = { Text(stringResource(R.string.sleep_timer)) },
            confirmButton = {
                TextButton(
                    onClick = {
                        showSleepTimerDialog = false
                        playerConnection.service.sleepTimer.start(sleepTimerValue.roundToInt())
                    },
                ) {
                    Text(stringResource(android.R.string.ok))
                }
            },
            dismissButton = {
                TextButton(
                    onClick = { showSleepTimerDialog = false },
                ) {
                    Text(stringResource(android.R.string.cancel))
                }
            },
            text = {
                Column(horizontalAlignment = Alignment.CenterHorizontally) {
                    Text(
                        text = pluralStringResource(
                            R.plurals.minute,
                            sleepTimerValue.roundToInt(),
                            sleepTimerValue.roundToInt()
                        ),
                        style = MaterialTheme.typography.bodyLarge,
                    )

                    Slider(
                        value = sleepTimerValue,
                        onValueChange = { sleepTimerValue = it },
                        valueRange = 5f..120f,
                        steps = (120 - 5) / 5 - 1,
                    )

                    OutlinedButton(
                        onClick = {
                            showSleepTimerDialog = false
                            playerConnection.service.sleepTimer.start(-1)
                        },
                    ) {
                        Text(stringResource(R.string.end_of_song))
                    }
                }
            },
        )
    }

    var showChoosePlaylistDialog by rememberSaveable {
        mutableStateOf(false)
    }

    LaunchedEffect(playbackState) {
        if (playbackState == STATE_READY) {
            while (isActive) {
                delay(100)
                position = playerConnection.player.currentPosition
                duration = playerConnection.player.duration
            }
        }
    }

    val currentFormat by playerConnection.currentFormat.collectAsState(initial = null)

    var showDetailsDialog by rememberSaveable {
        mutableStateOf(false)
    }

    if (showDetailsDialog) {
        AlertDialog(
            properties = DialogProperties(usePlatformDefaultWidth = false),
            onDismissRequest = { showDetailsDialog = false },
            containerColor = if (useBlackBackground) Color.Black else AlertDialogDefaults.containerColor,
            icon = {
                Icon(
                    painter = painterResource(R.drawable.info),
                    contentDescription = null,
                )
            },
            confirmButton = {
                TextButton(
                    onClick = { showDetailsDialog = false },
                ) {
                    Text(stringResource(android.R.string.ok))
                }
            },
            text = {
                Column(
                    modifier =
                        Modifier
                            .sizeIn(minWidth = 280.dp, maxWidth = 560.dp)
                            .verticalScroll(rememberScrollState()),
                ) {
                    listOf(
                        stringResource(R.string.song_title) to mediaMetadata?.title,
                        stringResource(R.string.song_artists) to mediaMetadata?.artists?.joinToString { it.name },
                        stringResource(R.string.media_id) to mediaMetadata?.id,
                        "Itag" to currentFormat?.itag?.toString(),
                        stringResource(R.string.mime_type) to currentFormat?.mimeType,
                        stringResource(R.string.codecs) to currentFormat?.codecs,
                        stringResource(R.string.bitrate) to currentFormat?.bitrate?.let { "${it / 1000} Kbps" },
                        stringResource(R.string.sample_rate) to currentFormat?.sampleRate?.let { "$it Hz" },
                        stringResource(R.string.loudness) to currentFormat?.loudnessDb?.let { "$it dB" },
                        stringResource(R.string.volume) to "${(playerConnection.player.volume * 100).toInt()}%",
                        stringResource(R.string.file_size) to
                                currentFormat?.contentLength?.let {
                                    Formatter.formatShortFileSize(
                                        context,
                                        it
                                    )
                                },
                    ).forEach { (label, text) ->
                        val displayText = text ?: stringResource(R.string.unknown)
                        Text(
                            text = label,
                            style = MaterialTheme.typography.labelMedium,
                        )
                        Text(
                            text = displayText,
                            style = MaterialTheme.typography.titleMedium,
                            modifier =
                                Modifier.clickable(
                                    interactionSource = remember { MutableInteractionSource() },
                                    indication = null,
                                    onClick = {
                                        clipboardManager.setText(AnnotatedString(displayText))
                                        Toast.makeText(context, R.string.copied, Toast.LENGTH_SHORT)
                                            .show()
                                    },
                                ),
                        )
                        Spacer(Modifier.height(8.dp))
                    }
                }
            },
        )
    }

    val queueSheetState =
        rememberBottomSheetState(
            dismissedBound = QueuePeekHeight + WindowInsets.systemBars.asPaddingValues()
                .calculateBottomPadding(),
            expandedBound = state.expandedBound,
        )

    var showAudioEffectsDialog by remember { mutableStateOf(false) }
    var likeButtonRefresh by remember { mutableStateOf(0) }

    // Audio Effects State Management
    val sharedPrefs = remember { context.getSharedPreferences("audio_effects", Context.MODE_PRIVATE) }
    
    // Audio effects state variables
    var bassBoostEnabled by remember { mutableStateOf(sharedPrefs.getBoolean("bass_boost_enabled", false)) }
    var bassBoost by remember { mutableStateOf(sharedPrefs.getFloat("bass_boost", 0f)) }
    var is3DEnabled by remember { mutableStateOf(sharedPrefs.getBoolean("is_3d", false)) }
    var bassLevel by remember { mutableStateOf(sharedPrefs.getFloat("bass_level", 50f)) }
    var midLevel by remember { mutableStateOf(sharedPrefs.getFloat("mid_level", 50f)) }
    var trebleLevel by remember { mutableStateOf(sharedPrefs.getFloat("treble_level", 50f)) }
    var reverbEnabled by remember { mutableStateOf(sharedPrefs.getBoolean("reverb_enabled", false)) }
    var loudnessGain by remember { mutableStateOf(sharedPrefs.getFloat("loudness_gain", 0f)) }
    var echoStrength by remember { mutableStateOf(sharedPrefs.getFloat("echo_strength", 0f)) }

    // Audio effects management functions
    fun saveAudioEffectSettings() {
        with(sharedPrefs.edit()) {
            putBoolean("bass_boost_enabled", bassBoostEnabled)
            putFloat("bass_boost", bassBoost)
            putBoolean("is_3d", is3DEnabled)
            putFloat("bass_level", bassLevel)
            putFloat("mid_level", midLevel)
            putFloat("treble_level", trebleLevel)
            putBoolean("reverb_enabled", reverbEnabled)
            putFloat("loudness_gain", loudnessGain)
            putFloat("echo_strength", echoStrength)
            apply()
        }
    }

    fun resetAllAudioEffects() {
        bassBoostEnabled = false
        bassBoost = 0f
        is3DEnabled = false
        bassLevel = 50f
        midLevel = 50f
        trebleLevel = 50f
        reverbEnabled = false
        loudnessGain = 0f
        echoStrength = 0f
        saveAudioEffectSettings()
    }

    // Apply audio effects to the AudioEffectsManager with enhanced error handling
    LaunchedEffect(bassBoostEnabled, bassBoost) {
        try {
            // Add delay to ensure service is fully initialized
            kotlinx.coroutines.delay(500)
            
            // Check if service is connected and player is ready
            if (playerConnection.service != null && playerConnection.player != null) {
                try {
                    val audioEffectsManager = playerConnection.service.getAudioEffectsManager()
                    if (audioEffectsManager != null) {
                        // Get current audio session ID with additional safety checks
                        val sessionId = try {
                            playerConnection.player.audioSessionId
                        } catch (e: Exception) {
                            android.util.Log.e("Player", "Failed to get audio session ID", e)
                            return@LaunchedEffect
                        }
                        
                        if (sessionId != AudioEffect.ERROR_BAD_VALUE && sessionId > 0) {
                            try {
                                audioEffectsManager.setAudioSessionId(sessionId)
                                kotlinx.coroutines.delay(100) // Small delay after setting session
                                audioEffectsManager.setBassBoost(bassBoostEnabled, bassBoost)
                                android.util.Log.d("Player", "Bass boost applied successfully: enabled=$bassBoostEnabled, level=$bassBoost")
                            } catch (e: Exception) {
                                android.util.Log.e("Player", "Failed to apply bass boost", e)
                                // Don't crash the app, just log the error
                            }
                        } else {
                            android.util.Log.w("Player", "Invalid audio session ID: $sessionId, skipping bass boost")
                        }
                    } else {
                        android.util.Log.w("Player", "AudioEffectsManager is null, skipping bass boost")
                    }
                } catch (e: Exception) {
                    android.util.Log.e("Player", "Error accessing AudioEffectsManager", e)
                    // Don't crash the app, just log the error
                }
            } else {
                android.util.Log.w("Player", "Service or player not ready, skipping bass boost")
            }
        } catch (e: Exception) {
            android.util.Log.e("Player", "Error in bass boost LaunchedEffect", e)
            // Don't crash the app, just log the error
        }
    }

    LaunchedEffect(is3DEnabled) {
        try {
            // Add delay to ensure service is fully initialized
            kotlinx.coroutines.delay(100)
            val audioEffectsManager = playerConnection.service.getAudioEffectsManager()
            if (audioEffectsManager != null) {
                try {
                    audioEffectsManager.set3DEnabled(is3DEnabled)
                    android.util.Log.d("Player", "3D effect applied successfully: enabled=$is3DEnabled")
                } catch (e: Exception) {
                    android.util.Log.e("Player", "Failed to apply 3D effect", e)
                    // Don't crash the app, just log the error
                }
            } else {
                android.util.Log.w("Player", "AudioEffectsManager is null, skipping 3D effect")
            }
        } catch (e: Exception) {
            android.util.Log.e("Player", "Error in 3D effect LaunchedEffect", e)
            // Don't crash the app, just log the error
        }
    }

    LaunchedEffect(bassLevel, midLevel, trebleLevel) {
        try {
            val audioEffectsManager = playerConnection.service.getAudioEffectsManager()
            if (audioEffectsManager != null) {
                try {
                    audioEffectsManager.setEqualizer(bassLevel, midLevel, trebleLevel)
                    android.util.Log.d("Player", "Equalizer applied successfully: bass=$bassLevel, mid=$midLevel, treble=$trebleLevel")
                } catch (e: Exception) {
                    android.util.Log.e("Player", "Failed to apply equalizer", e)
                    // Don't crash the app, just log the error
                }
            } else {
                android.util.Log.w("Player", "AudioEffectsManager is null, skipping equalizer")
            }
        } catch (e: Exception) {
            android.util.Log.e("Player", "Error in equalizer LaunchedEffect", e)
            // Don't crash the app, just log the error
        }
    }

    LaunchedEffect(reverbEnabled) {
        try {
            val audioEffectsManager = playerConnection.service.getAudioEffectsManager()
            if (audioEffectsManager != null) {
                try {
                    audioEffectsManager.setReverb(reverbEnabled, 0)
                    android.util.Log.d("Player", "Reverb applied successfully: enabled=$reverbEnabled")
                } catch (e: Exception) {
                    android.util.Log.e("Player", "Failed to apply reverb", e)
                    // Don't crash the app, just log the error
                }
            } else {
                android.util.Log.w("Player", "AudioEffectsManager is null, skipping reverb")
            }
        } catch (e: Exception) {
            android.util.Log.e("Player", "Error in reverb LaunchedEffect", e)
            // Don't crash the app, just log the error
        }
    }

    LaunchedEffect(loudnessGain) {
        try {
            val audioEffectsManager = playerConnection.service.getAudioEffectsManager()
            if (audioEffectsManager != null) {
                try {
                    audioEffectsManager.setLoudnessGain(loudnessGain)
                    android.util.Log.d("Player", "Loudness gain applied successfully: gain=$loudnessGain")
                } catch (e: Exception) {
                    android.util.Log.e("Player", "Failed to apply loudness gain", e)
                    // Don't crash the app, just log the error
                }
            } else {
                android.util.Log.w("Player", "AudioEffectsManager is null, skipping loudness gain")
            }
        } catch (e: Exception) {
            android.util.Log.e("Player", "Error in loudness gain LaunchedEffect", e)
            // Don't crash the app, just log the error
        }
    }

    LaunchedEffect(echoStrength) {
        try {
            val audioEffectsManager = playerConnection.service.getAudioEffectsManager()
            if (audioEffectsManager != null) {
                try {
                    audioEffectsManager.setEchoStrength(echoStrength)
                    android.util.Log.d("Player", "Echo strength applied successfully: strength=$echoStrength")
                } catch (e: Exception) {
                    android.util.Log.e("Player", "Failed to apply echo strength", e)
                    // Don't crash the app, just log the error
                }
            } else {
                android.util.Log.w("Player", "AudioEffectsManager is null, skipping echo")
            }
        } catch (e: Exception) {
            android.util.Log.e("Player", "Error in echo strength LaunchedEffect", e)
            // Don't crash the app, just log the error
        }
    }

    // Audio Effects Animation State Management
    var hasActiveEffects by remember { mutableStateOf(false) }
    
    // Function to check and update active effects - INSTANT response
    fun updateActiveEffects() {
        // Use current state variables for instant response
        // Bass Boost: Check only if value > 0, no need to check enabled flag
        val bassBoostActive = bassBoost > 0
        val threeDActive = is3DEnabled
        val equalizerActive = bassLevel != 50f || midLevel != 50f || trebleLevel != 50f
        val reverbActive = reverbEnabled
        val loudnessActive = loudnessGain > 0
        val echoActive = echoStrength > 0

        // Update animation state immediately
        hasActiveEffects = bassBoostActive || threeDActive || equalizerActive || reverbActive || loudnessActive || echoActive
    }
    
    // Update hasActiveEffects when preferences change
    LaunchedEffect(Unit) {
        // Initial check
        updateActiveEffects()
    }
    
    // Update animation state when any effect changes - INSTANT response
    LaunchedEffect(bassBoostEnabled, bassBoost, is3DEnabled, bassLevel, midLevel, trebleLevel, reverbEnabled, loudnessGain, echoStrength) {
        // Update immediately without delay for instant animation
        updateActiveEffects()
    }
    
    // Additional instant update for bass boost specifically
    LaunchedEffect(bassBoostEnabled, bassBoost) {
        // Check only bass boost value, not the enabled flag
        hasActiveEffects = bassBoost > 0 || 
                is3DEnabled || 
                bassLevel != 50f || midLevel != 50f || trebleLevel != 50f ||
                reverbEnabled || 
                loudnessGain > 0 || 
                echoStrength > 0
    }

    // Debug log
    LaunchedEffect(hasActiveEffects) {
        println("Player: hasActiveEffects = $hasActiveEffects")
        println("Player: bass_boost_enabled = $bassBoostEnabled")
        println("Player: bass_boost = $bassBoost")
        println("Player: is_3d = $is3DEnabled")
        println("Player: bass_level = $bassLevel")
        println("Player: mid_level = $midLevel")
        println("Player: treble_level = $trebleLevel")
        println("Player: reverb_enabled = $reverbEnabled")
        println("Player: loudness_gain = $loudnessGain")
        println("Player: echo_strength = $echoStrength")
    }

    BottomSheet(
        state = state,
        modifier = modifier,
        brushBackgroundColor =
            if (gradientColors.size >=
                2 &&
                state.value > changeBound
            ) {
                Brush.verticalGradient(gradientColors)
            } else {
                Brush.verticalGradient(
                    listOf(
                        MaterialTheme.colorScheme.surfaceContainer,
                        MaterialTheme.colorScheme.surfaceContainer,
                    ),
                )
            },
        onDismiss = {
            playerConnection.service.clearAutomix()
            playerConnection.player.stop()
            playerConnection.player.clearMediaItems()
        },
        collapsedContent = {
            MiniPlayer(
                position = position,
                duration = duration,
                onExpand = { state.expandSoft() }
            )
        }
    ) {
        val controlsContent: @Composable ColumnScope.(MediaMetadata) -> Unit = { mediaMetadata ->
            Spacer(Modifier.height(12.dp))
            // Middle-screen metadata hidden - using top title bar and bottom Instagram-style detail only

            Spacer(Modifier.height(320.dp))

            // Hidden play/pause and navigation buttons row
            Row(
                verticalAlignment = Alignment.CenterVertically,
                modifier =
                    Modifier
                        .fillMaxWidth()
                        .padding(horizontal = PlayerHorizontalPadding),
            ) {
                // Hidden repeat button
                Box(modifier = Modifier.weight(1f))

                // Hidden previous button
                Box(modifier = Modifier.weight(1f))

                // Hidden play/pause button
                Spacer(Modifier.width(8.dp))
                Box(modifier = Modifier.size(72.dp))
                Spacer(Modifier.width(8.dp))

                // Hidden next button
                Box(modifier = Modifier.weight(1f))

                // Hidden like button
                Box(modifier = Modifier.weight(1f))
            }
        }

        // Main content with full thumbnail background and gestures
        Box(
            modifier = Modifier.fillMaxSize()
        ) {
            // Full screen thumbnail with smooth swipe gestures
            FullScreenThumbnailWithGestures(
                mediaMetadata = mediaMetadata,
                playerConnection = playerConnection,
                onOpenFullscreenLyrics = onOpenFullscreenLyrics,
                onPlayPauseClick = {
                    if (playbackState == STATE_ENDED) {
                        playerConnection.player.seekTo(0, 0)
                        playerConnection.player.playWhenReady = true
                    } else {
                        playerConnection.player.togglePlayPause()
                    }
                },
                onShowAudioEffectsDialog = { showAudioEffectsDialog = true },
                likeButtonRefresh = likeButtonRefresh,
                onLikeButtonRefresh = { likeButtonRefresh++ },
                hasActiveEffects = hasActiveEffects,
                modifier = Modifier.fillMaxSize()
            )

            // Black gradient behind the system status bar (increased opacity)
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(WindowInsets.systemBars.asPaddingValues().calculateTopPadding())
                    .align(Alignment.TopStart)
                    .background(
                        brush = Brush.verticalGradient(
                            colors = listOf(Color.Black.copy(alpha = 0.85f), Color.Transparent)
                        )
                    )
            )

            // New layout with song title at top and controls at bottom
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .windowInsetsPadding(WindowInsets.systemBars.only(WindowInsetsSides.Horizontal))
                    .padding(bottom = 0.dp)
            ) {
                // Song title at top (near status bar) with more button on right side
                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(
                            top = WindowInsets.systemBars.asPaddingValues().calculateTopPadding() + 16.dp,
                            start = PlayerHorizontalPadding,
                            end = PlayerHorizontalPadding
                        )
                ) {
                    // App name with glowing red effect - Left side
                    val infiniteTransition = rememberInfiniteTransition(label = "app_name_glow")
                    val glowAlpha by infiniteTransition.animateFloat(
                        initialValue = 0.6f,
                        targetValue = 1f,
                        animationSpec = infiniteRepeatable(
                            animation = tween(durationMillis = 1500, easing = LinearEasing),
                            repeatMode = RepeatMode.Reverse
                        ),
                        label = "glow_alpha"
                    )

                    Row(
                        modifier = Modifier.align(Alignment.CenterStart),
                        verticalAlignment = Alignment.CenterVertically,
                        horizontalArrangement = Arrangement.spacedBy(8.dp)
                    ) {
                        Text(
                            text = "Ai Music",
                            style = MaterialTheme.typography.titleLarge,
                            color = Color(0xFFFF0050).copy(alpha = glowAlpha),
                            fontWeight = FontWeight.Bold,
                            modifier = Modifier
                                .background(
                                    brush = Brush.horizontalGradient(
                                        colors = listOf(
                                            Color(0xFFFF0050).copy(alpha = 0.3f * glowAlpha),
                                            Color.Transparent
                                        )
                                    ),
                                    shape = RoundedCornerShape(8.dp)
                                )
                                .padding(horizontal = 12.dp, vertical = 6.dp)
                        )
                    }

                    // More button on top right
                    Box(
                        modifier = Modifier
                            .size(42.dp)
                            .clip(RoundedCornerShape(24.dp))
                            .background(Color.Black.copy(alpha = 0.6f))
                            .clickable {
                                menuState.show {
                                    PlayerMenu(
                                        mediaMetadata = mediaMetadata,
                                        navController = navController,
                                        playerBottomSheetState = state,
                                        onShowDetailsDialog = { showDetailsDialog = true },
                                        onDismiss = menuState::dismiss,
                                        onOpenQueue = { queueSheetState.expandSoft() }
                                    )
                                }
                            }
                            .align(Alignment.CenterEnd),
                        contentAlignment = Alignment.Center
                    ) {
                        Image(
                            painter = painterResource(R.drawable.more_horiz),
                            contentDescription = null,
                            colorFilter = ColorFilter.tint(Color.White),
                            modifier = Modifier.size(24.dp)
                        )
                    }
                }

                Spacer(Modifier.weight(1f))

                // Controls at bottom - QUEUE KE JUST UPPER
                Column(
                    modifier = Modifier
                        .fillMaxWidth()
                        .padding(bottom = 16.dp)
                ) {
                    mediaMetadata?.let {
                        controlsContent(it)
                    }
                }
            }

            // INSTAGRAM REELS STYLE VERTICAL ACTION BUTTONS - BOTTOM RIGHT
            Column(
                modifier = Modifier
                    .align(Alignment.BottomEnd)
                    .padding(
                        end = 20.dp,
                        bottom = 120.dp
                    ),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {

                // Like Button with count
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally,
                    verticalArrangement = Arrangement.spacedBy(4.dp)
                ) {
                    Box(
                        modifier = Modifier
                            .size(48.dp)
                            .clip(RoundedCornerShape(24.dp))
                            .background(Color.Black.copy(alpha = 0.6f))
                            .clickable {
                                // Like button: Toggle like/unlike (only way to unlike)
                                playerConnection.toggleLike()
                                // Force refresh like button
                                likeButtonRefresh++
                            },
                        contentAlignment = Alignment.Center
                    ) {
                        // Force refresh like button when likeButtonRefresh changes
                        LaunchedEffect(likeButtonRefresh) {
                            // This will trigger recomposition
                        }

                        Image(
                            painter = painterResource(
                                if (currentSong?.song?.liked == true) R.drawable.favorite
                                else R.drawable.favorite_border
                            ),
                            contentDescription = null,
                            colorFilter = ColorFilter.tint(
                                if (currentSong?.song?.liked == true) Color(0xFFFF0050)
                                else Color.White
                            ),
                            modifier = Modifier.size(28.dp)
                        )
                    }
                    Text(
                        text = "Like",
                        color = Color.White,
                        style = MaterialTheme.typography.labelSmall,
                        fontSize = 12.sp
                    )
                }

                // Download Button with progress
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally,
                    verticalArrangement = Arrangement.spacedBy(4.dp)
                ) {
                    Box(
                        modifier = Modifier
                            .size(48.dp)
                            .clip(RoundedCornerShape(24.dp))
                            .background(Color.Black.copy(alpha = 0.6f))
                            .clickable {
                                if (download?.state == Download.STATE_COMPLETED) {
                                    DownloadService.sendRemoveDownload(
                                        context,
                                        ExoDownloadService::class.java,
                                        mediaMetadata?.id ?: "",
                                        false,
                                    )
                                } else {
                                    database.transaction {
                                        mediaMetadata?.let { insert(it) }
                                    }
                                    val downloadRequest =
                                        DownloadRequest
                                            .Builder(mediaMetadata?.id ?: "", (mediaMetadata?.id ?: "").toUri())
                                            .setCustomCacheKey(mediaMetadata?.id ?: "")
                                            .setData((mediaMetadata?.title ?: "").toByteArray())
                                            .build()
                                    DownloadService.sendAddDownload(
                                        context,
                                        ExoDownloadService::class.java,
                                        downloadRequest,
                                        false,
                                    )
                                }
                            },
                        contentAlignment = Alignment.Center
                    ) {
                        if (download?.state == Download.STATE_DOWNLOADING) {
                            val progress = (download?.percentDownloaded ?: 0f) / 100f
                            val animatedProgress by animateFloatAsState(
                                targetValue = progress,
                                animationSpec = tween(durationMillis = 300, easing = FastOutSlowInEasing),
                                label = "downloadProgress"
                            )

                            Canvas(
                                modifier = Modifier
                                    .fillMaxSize()
                                    .padding(4.dp)
                            ) {
                                val strokeWidth = 3.dp.toPx()
                                val radius = (size.minDimension - strokeWidth) / 2
                                val center = androidx.compose.ui.geometry.Offset(size.width / 2, size.height / 2)

                                // Background circle
                                drawCircle(
                                    color = Color.White.copy(alpha = 0.3f),
                                    radius = radius,
                                    center = center,
                                    style = Stroke(width = strokeWidth)
                                )

                                // Progress circle
                                if (animatedProgress > 0f) {
                                    drawArc(
                                        color = Color.White,
                                        startAngle = -90f,
                                        sweepAngle = 360f * animatedProgress,
                                        useCenter = false,
                                        topLeft = androidx.compose.ui.geometry.Offset(center.x - radius, center.y - radius),
                                        size = androidx.compose.ui.geometry.Size(radius * 2, radius * 2),
                                        style = Stroke(width = strokeWidth, cap = StrokeCap.Round)
                                    )
                                }
                            }

                            // Small progress text in center
                            val progressPercent = (download?.percentDownloaded ?: 0f).toInt()
                            Text(
                                text = "$progressPercent%",
                                color = Color.White,
                                style = MaterialTheme.typography.labelSmall,
                                fontSize = 10.sp,
                                modifier = Modifier.alpha(0.9f)
                            )
                        } else {
                            val iconResource = when (download?.state) {
                                Download.STATE_COMPLETED -> R.drawable.offline
                                Download.STATE_DOWNLOADING -> R.drawable.pause
                                Download.STATE_FAILED -> R.drawable.error
                                else -> R.drawable.download
                            }

                            val iconColor = when (download?.state) {
                                Download.STATE_FAILED -> Color(0xFFFF3048)
                                Download.STATE_COMPLETED -> Color(0xFF34C759)
                                else -> Color.White
                            }

                            Image(
                                painter = painterResource(iconResource),
                                contentDescription = when (download?.state) {
                                    Download.STATE_COMPLETED -> "Downloaded"
                                    Download.STATE_DOWNLOADING -> "Downloading..."
                                    Download.STATE_FAILED -> "Download failed"
                                    else -> "Download"
                                },
                                colorFilter = ColorFilter.tint(iconColor),
                                modifier = Modifier.size(28.dp)
                            )
                        }
                    }
                    Text(
                        text = when (download?.state) {
                            Download.STATE_COMPLETED -> "Saved"
                            Download.STATE_DOWNLOADING -> "Downloading"
                            Download.STATE_FAILED -> "Failed"
                            else -> "Download"
                        },
                        color = Color.White,
                        style = MaterialTheme.typography.labelSmall,
                        fontSize = 12.sp
                    )
                }


                // Audio Effects Button
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally,
                    verticalArrangement = Arrangement.spacedBy(4.dp)
                ) {
                    Box(
                        modifier = Modifier
                            .size(48.dp)
                            .clip(RoundedCornerShape(24.dp))
                            .background(Color.Black.copy(alpha = 0.6f))
                            .clickable {
                                android.util.Log.d("AudioEffects", "Effects button clicked")
                                showAudioEffectsDialog = true
                            },
                        contentAlignment = Alignment.Center
                    ) {
                        Image(
                            painter = painterResource(R.drawable.equalizer),
                            contentDescription = "Audio Effects",
                            colorFilter = ColorFilter.tint(Color.White),
                            modifier = Modifier.size(28.dp)
                        )
                    }
                    Text(
                        text = "Effects",
                        color = Color.White,
                        style = MaterialTheme.typography.labelSmall,
                        fontSize = 12.sp
                    )
                }

                // Sleep Timer Button
                Column(
                    horizontalAlignment = Alignment.CenterHorizontally,
                    verticalArrangement = Arrangement.spacedBy(4.dp)
                ) {
                    Box(
                        modifier = Modifier
                            .size(48.dp)
                            .clip(RoundedCornerShape(24.dp))
                            .background(Color.Black.copy(alpha = 0.6f))
                            .clickable {
                                if (sleepTimerEnabled) {
                                    playerConnection.service.sleepTimer.clear()
                                } else {
                                    showSleepTimerDialog = true
                                }
                            },
                        contentAlignment = Alignment.Center
                    ) {
                        if (sleepTimerEnabled) {
                            Text(
                                text = makeTimeString(sleepTimerTimeLeft),
                                color = Color(0xFFFFD600),
                                style = MaterialTheme.typography.labelMedium,
                                fontSize = 12.sp,
                                fontWeight = FontWeight.Bold
                            )
                        } else {
                            Image(
                                painter = painterResource(R.drawable.bedtime),
                                contentDescription = "Sleep Timer",
                                colorFilter = ColorFilter.tint(Color.White),
                                modifier = Modifier.size(28.dp)
                            )
                        }
                    }
                    Text(
                        text = if (sleepTimerEnabled) "Stop Timer" else "Timer",
                        color = Color.White,
                        style = MaterialTheme.typography.labelSmall,
                        fontSize = 12.sp
                    )
                }
            }

            // PROGRESS SLIDER - BOTTOM LEFT
            Column(
                modifier = Modifier
                    .align(Alignment.BottomStart)
                    .fillMaxWidth()
                    .padding(
                        start = PlayerHorizontalPadding,
                        end = 80.dp,
                        bottom = 60.dp
                    )
            ) {
                // Small song info display above seekbar
                mediaMetadata?.let { md ->
                    Row(
                        verticalAlignment = Alignment.CenterVertically,
                        modifier = Modifier
                            .fillMaxWidth()
                            .padding(bottom = 8.dp)
                    ) {
                        AsyncImage(
                            model = md.thumbnailUrl,
                            contentDescription = null,
                            contentScale = ContentScale.Crop,
                            modifier = Modifier
                                .size(48.dp)
                                .clip(RoundedCornerShape(8.dp))
                        )

                        Spacer(Modifier.width(8.dp))

                        Column(
                            verticalArrangement = Arrangement.Center,
                            modifier = Modifier.fillMaxWidth()
                        ) {
                            Text(
                                text = md.title ?: "",
                                color = MaterialTheme.colorScheme.primary,
                                style = MaterialTheme.typography.titleSmall,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis
                            )

                            Text(
                                text = md.artists.joinToString { it.name },
                                color = MaterialTheme.colorScheme.primary,
                                style = MaterialTheme.typography.bodySmall,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis
                            )
                        }
                    }
                }

                // Seekbar section with gesture protection
                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .zIndex(999f) // High z-index for seekbar area
                        .pointerInput(Unit) {
                            try {
                                // Consume all pointer events in seekbar area to prevent gesture conflicts
                                detectTapGestures { }
                                detectHorizontalDragGestures { _, _ -> }
                                detectVerticalDragGestures { _, _ -> }
                            } catch (e: Exception) {
                                android.util.Log.e("Player", "Error in seekbar gesture protection", e)
                            }
                        }
                ) {
                    when (sliderStyle) {
                    SliderStyle.DEFAULT -> {
                        Box(
                            modifier = Modifier
                                .fillMaxWidth()
                                .zIndex(1000f) // Very high z-index to ensure seekbar is on top of everything
                        ) {
                            Slider(
                                value = (sliderPosition ?: position).toFloat(),
                                onValueChange = {
                                    sliderPosition = it.toLong()
                                },
                                onValueChangeFinished = {
                                    sliderPosition?.let {
                                        playerConnection.player.seekTo(it)
                                        position = it
                                    }
                                    sliderPosition = null
                                },
                                valueRange = 0f..(if (duration == C.TIME_UNSET) 0f else duration.toFloat()),
                                colors = SliderDefaults.colors(
                                    thumbColor = MaterialTheme.colorScheme.primary,
                                    activeTrackColor = MaterialTheme.colorScheme.primary,
                                    inactiveTrackColor = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.3f)
                                ),
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .zIndex(1001f) // Even higher z-index for the slider itself
                                    .clickable { } // Ensure touch events are handled properly
                            )
                        }
                    }

                    SliderStyle.SQUIGGLY -> {
                        Box(
                            modifier = Modifier
                                .fillMaxWidth()
                                .zIndex(1000f) // Very high z-index to ensure seekbar is on top of everything
                        ) {
                            SquigglySlider(
                                value = (sliderPosition ?: position).toFloat(),
                                valueRange = 0f..(if (duration == C.TIME_UNSET) 0f else duration.toFloat()),
                                onValueChange = {
                                    sliderPosition = it.toLong()
                                },
                                onValueChangeFinished = {
                                    sliderPosition?.let {
                                        playerConnection.player.seekTo(it)
                                        position = it
                                    }
                                    sliderPosition = null
                                },
                                colors = SliderDefaults.colors(
                                    activeTrackColor = Color.White,
                                    inactiveTrackColor = Color.White.copy(alpha = 0.3f),
                                    activeTickColor = Color.White,
                                    inactiveTickColor = Color.White.copy(alpha = 0.3f),
                                    thumbColor = Color.White
                                ),
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .zIndex(1001f) // Even higher z-index for the slider itself
                                    .clickable { }, // Ensure touch events are handled properly
                                squigglesSpec =
                                    SquigglySlider.SquigglesSpec(
                                        amplitude = if (isPlaying) (2.dp).coerceAtLeast(2.dp) else 0.dp,
                                        strokeWidth = 3.dp,
                                    ),
                            )
                        }
                    }

                    SliderStyle.SLIM -> {
                        Box(
                            modifier = Modifier
                                .fillMaxWidth()
                                .zIndex(1000f) // Very high z-index to ensure seekbar is on top of everything
                        ) {
                            Slider(
                                value = (sliderPosition ?: position).toFloat(),
                                onValueChange = {
                                    sliderPosition = it.toLong()
                                },
                                onValueChangeFinished = {
                                    sliderPosition?.let {
                                        playerConnection.player.seekTo(it)
                                        position = it
                                    }
                                    sliderPosition = null
                                },
                                valueRange = 0f..(if (duration == C.TIME_UNSET) 0f else duration.toFloat()),
                                colors = SliderDefaults.colors(
                                    thumbColor = MaterialTheme.colorScheme.primary,
                                    activeTrackColor = MaterialTheme.colorScheme.primary,
                                    inactiveTrackColor = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.3f)
                                ),
                                modifier = Modifier
                                    .fillMaxWidth()
                                    .height(4.dp)
                                    .zIndex(1001f) // Even higher z-index for the slider itself
                                    .clickable { } // Ensure touch events are handled properly
                            )
                        }
                    }
                }
                } // Close the seekbar protection Box

                Spacer(Modifier.height(4.dp))

                Row(
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically,
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Text(
                        text = makeTimeString(sliderPosition ?: position),
                        style = MaterialTheme.typography.labelMedium,
                        color = Color.White,
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis,
                    )

                    Text(
                        text = if (duration != C.TIME_UNSET) makeTimeString(duration) else "",
                        style = MaterialTheme.typography.labelMedium,
                        color = Color.White,
                        maxLines = 1,
                        overflow = TextOverflow.Ellipsis,
                    )
                }
            }
        }

        // Queue component - restored for three-dot menu access
        Queue(
            state = queueSheetState,
            playerBottomSheetState = state,
            navController = navController,
            backgroundColor = MaterialTheme.colorScheme.surface,
            onBackgroundColor = MaterialTheme.colorScheme.onSurface,
            TextBackgroundColor = MaterialTheme.colorScheme.surface
        )

        // Simple Audio Effects Dialog
        if (showAudioEffectsDialog) {
            android.util.Log.d("AudioEffects", "Creating audio effects dialog")
            SimpleAudioEffectsDialog(
                bassBoost = bassBoost,
                onBassBoostChange = { newValue ->
                    bassBoost = newValue
                    // Auto-enable bass boost when value > 0
                    if (newValue > 0) {
                        bassBoostEnabled = true
                    } else {
                        bassBoostEnabled = false
                    }
                    // Update animation state immediately for instant response
                    hasActiveEffects = newValue > 0 || is3DEnabled || bassLevel != 50f || midLevel != 50f || trebleLevel != 50f || reverbEnabled || loudnessGain > 0 || echoStrength > 0
                    saveAudioEffectSettings()
                },
                is3DEnabled = is3DEnabled,
                on3DToggle = { enabled ->
                    is3DEnabled = enabled
                    // Update animation state immediately for instant response
                    hasActiveEffects = bassBoost > 0 || enabled || bassLevel != 50f || midLevel != 50f || trebleLevel != 50f || reverbEnabled || loudnessGain > 0 || echoStrength > 0
                    saveAudioEffectSettings()
                },
                reverbEnabled = reverbEnabled,
                onReverbToggle = { enabled ->
                    reverbEnabled = enabled
                    // Update animation state immediately for instant response
                    hasActiveEffects = bassBoost > 0 || is3DEnabled || bassLevel != 50f || midLevel != 50f || trebleLevel != 50f || enabled || loudnessGain > 0 || echoStrength > 0
                    saveAudioEffectSettings()
                },
                bassLevel = bassLevel,
                onBassLevelChange = { newValue ->
                    bassLevel = newValue
                    saveAudioEffectSettings()
                },
                midLevel = midLevel,
                onMidLevelChange = { newValue ->
                    midLevel = newValue
                    saveAudioEffectSettings()
                },
                trebleLevel = trebleLevel,
                onTrebleLevelChange = { newValue ->
                    trebleLevel = newValue
                    saveAudioEffectSettings()
                },
                loudnessGain = loudnessGain,
                onLoudnessGainChange = { newValue ->
                    loudnessGain = newValue
                    saveAudioEffectSettings()
                },
                echoStrength = echoStrength,
                onEchoStrengthChange = { newValue ->
                    echoStrength = newValue
                    saveAudioEffectSettings()
                },
                onResetAll = {
                    resetAllAudioEffects()
                },
                onClose = { showAudioEffectsDialog = false }
            )
        }
    }
}

@Composable
fun AudioEffectsAnimation(
    mediaMetadata: MediaMetadata?,
    isPlaying: Boolean,
    modifier: Modifier = Modifier
) {
    val infiniteTransition = rememberInfiniteTransition(label = "audio_effects_animation")
    
    // Red glow animation for frame - EXACTLY 2000ms
    val glowAnimation by infiniteTransition.animateFloat(
        initialValue = 0.4f,
        targetValue = 1f,
        animationSpec = if (isPlaying) {
            infiniteRepeatable(
                animation = tween(2000, easing = LinearEasing), // EXACTLY 2000ms
                repeatMode = RepeatMode.Reverse
            )
        } else {
            infiniteRepeatable(
                animation = tween(0, easing = LinearEasing),
                repeatMode = RepeatMode.Reverse
            )
        },
        label = "glow_animation"
    )
    
    // Wave animation for frame - EXACTLY 2000ms for rhythm
    val waveAnimation by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = if (isPlaying) {
            infiniteRepeatable(
                animation = tween(2000, easing = LinearEasing), // EXACTLY 2000ms
                repeatMode = RepeatMode.Restart
            )
        } else {
            infiniteRepeatable(
                animation = tween(0, easing = LinearEasing),
                repeatMode = RepeatMode.Restart
            )
        },
        label = "wave_animation"
    )
    
    
    Box(
        modifier = modifier,
        contentAlignment = Alignment.Center
    ) {
        // Dark overlay for better visibility
        Box(
            modifier = Modifier
                .fillMaxSize()
                .background(Color.Black.copy(alpha = 0.3f))
        )
        
        Box(
            modifier = Modifier.fillMaxSize(),
            contentAlignment = Alignment.Center
        ) {
            // Perfect square thumbnail - centered
            Box(
                modifier = Modifier
                    .size(180.dp, 180.dp) // Perfect square dimensions
                    .clip(RoundedCornerShape(12.dp))
            ) {
                AsyncImage(
                    model = mediaMetadata?.thumbnailUrl,
                    contentDescription = null,
                    contentScale = ContentScale.Crop,
                    modifier = Modifier
                        .fillMaxSize()
                        .clip(RoundedCornerShape(16.dp))
                )
                // Enhanced RED glow effect around thumbnail
                Box(
                    modifier = Modifier
                        .fillMaxSize()
                        .background(
                            brush = Brush.radialGradient(
                                colors = listOf(
                                    Color(0xFFFF0000).copy(alpha = 0.8f * glowAnimation), // Bright red center
                                    Color(0xFFFF0000).copy(alpha = 0.5f * glowAnimation), // Medium red
                                    Color(0xFFFF0000).copy(alpha = 0.2f * glowAnimation), // Fade red
                                    Color.Transparent
                                ),
                                radius = 150f // Larger glow radius for better visibility
                            ),
                            shape = RoundedCornerShape(16.dp)
                        )
                )
            }
            
            // Animation below thumbnail - properly centered
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(150.dp)
                    .padding(top = 200.dp) // Position below centered thumbnail
                    .padding(horizontal = 40.dp), // More horizontal padding for better centering
                contentAlignment = Alignment.Center
            ) {
                Canvas(
                    modifier = Modifier.fillMaxSize()
                ) {
                    val centerX = size.width / 2
                    val centerY = size.height / 2
                    val radius = 50.dp.toPx() // Smaller radius for better centering
                    
                    // Create wave animation below thumbnail
                    for (waveIndex in 0..3) {
                        val waveRadius = radius + (waveIndex * 15.dp.toPx()) // Closer waves
                        val waveAmplitude = 8.dp.toPx() * (1f - waveIndex * 0.2f) // Smaller amplitude
                        
                        val path = androidx.compose.ui.graphics.Path().apply {
                            var isFirstPoint = true
                            for (i in 0..360 step 2) {
                                val angle = i * kotlin.math.PI / 180f
                                val waveOffset = if (isPlaying) {
                                    kotlin.math.sin(
                                        (angle * 4 + 
                                        waveAnimation * kotlin.math.PI * 2 + 
                                        waveIndex * 0.5f).toDouble()
                                    ).toFloat() * waveAmplitude
                                } else {
                                    0f
                                }
                                
                                val x = centerX + kotlin.math.cos(angle.toDouble()).toFloat() * (waveRadius + waveOffset)
                                val y = centerY + kotlin.math.sin(angle.toDouble()).toFloat() * (waveRadius + waveOffset)
                                
                                if (isFirstPoint) {
                                    moveTo(x, y)
                                    isFirstPoint = false
                                } else {
                                    lineTo(x, y)
                                }
                            }
                            close()
                        }
                        
                        // Draw transparent wave
                        drawPath(
                            path = path,
                            color = Color(0xFFFF0000).copy(alpha = 0.0f),
                            style = Stroke(
                                width = (3f - waveIndex * 0.5f).dp.toPx(),
                                cap = StrokeCap.Round
                            )
                        )
                    }
                }
            }
            
            // Red oval animation below thumbnail when audio effects are applied
            Box(
                modifier = Modifier
                    .offset(y = 120.dp) // Position below thumbnail
                    .size(200.dp, 60.dp) // Oval dimensions
                    .background(
                        brush = Brush.radialGradient(
                            colors = listOf(
                                Color(0xFFFF0000).copy(alpha = 0.8f * glowAnimation),
                                Color(0xFFFF0000).copy(alpha = 0.4f * glowAnimation),
                                Color.Transparent
                            ),
                            radius = 100f
                        ),
                        shape = RoundedCornerShape(30.dp)
                    )
            ) {
                // Animated vertical bars inside the oval (like equalizer) - RED COLOR
                Canvas(
                    modifier = Modifier.fillMaxSize()
                ) {
                    val barWidth = 8.dp.toPx()
                    val barSpacing = 12.dp.toPx()
                    val centerY = size.height / 2
                    val totalBars = 12
                    
                    for (i in 0 until totalBars) {
                        // Enhanced rhythm animation - each bar has different phase for realistic equalizer effect
                        val barHeight = if (isPlaying) {
                            val phase = (i * 0.3 + waveAnimation * 2.0) * kotlin.math.PI // Faster animation
                            val baseHeight = 20.dp.toPx()
                            val variation = kotlin.math.sin(phase).toFloat() * 15.dp.toPx()
                            (baseHeight + variation).coerceAtLeast(5.dp.toPx())
                        } else {
                            5.dp.toPx()
                        }
                        val x = (i * (barWidth + barSpacing)) + (size.width - (totalBars * (barWidth + barSpacing))) / 2
                        
                        // RED COLOR for all bars with enhanced glow
                        drawRect(
                            color = Color(0xFFFF0000).copy(alpha = (0.8f + 0.2f * glowAnimation)),
                            topLeft = androidx.compose.ui.geometry.Offset(x, centerY - barHeight / 2),
                            size = androidx.compose.ui.geometry.Size(barWidth, barHeight)
                        )
                    }
                }
            }
        }
    }
}

@Composable
fun HologramThumbnailEffect(
    thumbnailUrl: String?,
    modifier: Modifier = Modifier
) {
    // Animation states
    val infiniteTransition = rememberInfiniteTransition(label = "hologram")
    
    // Rotating ring animation
    val ringRotation by infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 360f,
        animationSpec = infiniteRepeatable(
            animation = tween(4000, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "ring_rotation"
    )
    
    // Pulsing glow animation
    val glowAlpha by infiniteTransition.animateFloat(
        initialValue = 0.4f,
        targetValue = 1.0f,
        animationSpec = infiniteRepeatable(
            animation = tween(1200, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "glow_alpha"
    )
    
    // Floating animation - more realistic
    val floatOffset by infiniteTransition.animateFloat(
        initialValue = -8f,
        targetValue = 8f,
        animationSpec = infiniteRepeatable(
            animation = tween(3000, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "float_offset"
    )
    
    // Sound bars animation - synced with music
    val soundBarHeights = remember { List(12) { kotlin.random.Random.nextFloat() } }
    val soundBarAnimations = soundBarHeights.mapIndexed { index, _ ->
        infiniteTransition.animateFloat(
            initialValue = 0.2f,
            targetValue = 1.0f,
            animationSpec = infiniteRepeatable(
                animation = tween(300 + (index * 50), easing = LinearEasing),
                repeatMode = RepeatMode.Reverse
            ),
            label = "sound_bar_$index"
        )
    }

    Box(
        modifier = modifier
            .size(500.dp)
            .offset(y = floatOffset.dp),
        contentAlignment = Alignment.Center
    ) {
        // Realistic Electric Hologram Base (closer to avatar)
        Canvas(
            modifier = Modifier
                .size(500.dp)
                .offset(y = 80.dp)
        ) {
            val center = androidx.compose.ui.geometry.Offset(size.width / 2, size.height / 2)
            val baseRadius = 200f // Increased from 150f to make it bigger than thumbnail
            
            // Main hologram platform base (horizontal oval)
            drawOval(
                color = Color(0xFFFFD700).copy(alpha = glowAlpha * 0.6f),
                topLeft = androidx.compose.ui.geometry.Offset(center.x - baseRadius * 1.5f, center.y - baseRadius * 0.7f),
                size = androidx.compose.ui.geometry.Size(baseRadius * 3f, baseRadius * 1.4f),
                style = Stroke(width = 4f)
            )
            
            // Platform glow (horizontal oval)
            drawOval(
                color = Color(0xFFFFD700).copy(alpha = glowAlpha * 0.2f),
                topLeft = androidx.compose.ui.geometry.Offset(center.x - baseRadius * 1.5f, center.y - baseRadius * 0.7f),
                size = androidx.compose.ui.geometry.Size(baseRadius * 3f, baseRadius * 1.4f),
                style = Stroke(width = 12f)
            )
            
            // Electric lightning arcs (like your reference image)
            soundBarAnimations.forEachIndexed { index, barAnimation ->
                val baseAngle = (index * 360f / soundBarAnimations.size)
                val intensity = barAnimation.value
                
                // Create jagged lightning effect
                val lightningPoints = mutableListOf<Offset>()
                val arcStartAngle = baseAngle - 25f + (intensity * 10f)
                val arcEndAngle = baseAngle + 25f - (intensity * 10f)
                val segments = 8
                
                for (i in 0..segments) {
                    val segmentAngle = arcStartAngle + (arcEndAngle - arcStartAngle) * (i.toFloat() / segments)
                    val radiusVariation = baseRadius + (kotlin.math.sin(((ringRotation + index * 30f + i * 45f) * kotlin.math.PI / 180f).toDouble()) * 15f * intensity).toFloat()
                    val angleVariation = segmentAngle + (kotlin.math.cos(((ringRotation * 2f + i * 60f) * kotlin.math.PI / 180f).toDouble()) * 8f * intensity).toFloat()
                    
                    // Calculate elliptical coordinates for horizontal oval
                    val horizontalRadius = radiusVariation * 1.5f  // Wider horizontally
                    val verticalRadius = radiusVariation * 0.7f    // Narrower vertically
                    
                    val x = center.x + kotlin.math.cos((angleVariation * kotlin.math.PI / 180f).toDouble()).toFloat() * horizontalRadius
                    val y = center.y + kotlin.math.sin((angleVariation * kotlin.math.PI / 180f).toDouble()).toFloat() * verticalRadius
                    lightningPoints.add(androidx.compose.ui.geometry.Offset(x, y))
                }
                
                // Draw lightning arc segments
                for (i in 0 until lightningPoints.size - 1) {
                    val alpha = glowAlpha * intensity * (0.8f + kotlin.math.sin(((ringRotation + i * 45f) * kotlin.math.PI / 180f).toDouble()).toFloat() * 0.2f)
                    
                    // Main lightning bolt
                    drawLine(
                        color = Color(0xFFFFD700).copy(alpha = alpha),
                        start = lightningPoints[i],
                        end = lightningPoints[i + 1],
                        strokeWidth = 2f + (intensity * 2f)
                    )
                    
                    // Lightning glow
                    drawLine(
                        color = Color(0xFFFFD700).copy(alpha = alpha * 0.3f),
                        start = lightningPoints[i],
                        end = lightningPoints[i + 1],
                        strokeWidth = 6f + (intensity * 4f)
                    )
                    
                    // Electric sparks along the arc
                    if (i % 2 == 0 && intensity > 0.3f) {
                        val sparkSize = 1f + (intensity * 3f)
                        drawCircle(
                            color = Color(0xFFFFD700).copy(alpha = alpha),
                            radius = sparkSize,
                            center = lightningPoints[i]
                        )
                        
                        // Spark glow
                        drawCircle(
                            color = Color(0xFFFFD700).copy(alpha = alpha * 0.4f),
                            radius = sparkSize * 2f,
                            center = lightningPoints[i]
                        )
                    }
                }
            }
            
            // Floating energy dots around the oval platform
            val dotCount = 20 // More dots for bigger base
            for (i in 0 until dotCount) {
                val angle = (i * 360f / dotCount) + (ringRotation * 0.3f)
                val baseRadiusVariation = baseRadius + 30f + (kotlin.math.sin(((ringRotation + i * 45f) * kotlin.math.PI / 180f).toDouble()) * 15f).toFloat()
                
                // Calculate elliptical coordinates for oval dots pattern
                val horizontalDotRadius = baseRadiusVariation * 1.5f  // Wider horizontally
                val verticalDotRadius = baseRadiusVariation * 0.7f    // Narrower vertically
                
                val dotX = center.x + kotlin.math.cos((angle * kotlin.math.PI / 180f).toDouble()).toFloat() * horizontalDotRadius
                val dotY = center.y + kotlin.math.sin((angle * kotlin.math.PI / 180f).toDouble()).toFloat() * verticalDotRadius
                val dotIntensity = 0.5f + (kotlin.math.sin(((ringRotation * 2f + i * 30f) * kotlin.math.PI / 180f).toDouble()) * 0.5f).toFloat()
                
                // Main dot (bigger for bigger base)
                drawCircle(
                    color = Color(0xFFFFD700).copy(alpha = glowAlpha * dotIntensity),
                    radius = 3f + (dotIntensity * 3f),
                    center = androidx.compose.ui.geometry.Offset(dotX, dotY)
                )
                
                // Dot glow (bigger glow)
                drawCircle(
                    color = Color(0xFFFFD700).copy(alpha = glowAlpha * dotIntensity * 0.3f),
                    radius = 7f + (dotIntensity * 4f),
                    center = androidx.compose.ui.geometry.Offset(dotX, dotY)
                )
            }
            
            // Vertical music bars animation (bottom to top)
            val barCount = 12
            val barWidth = 8f
            val maxBarHeight = 80f
            val barSpacing = 15f
            val totalWidth = (barCount * barWidth) + ((barCount - 1) * barSpacing)
            val startX = center.x - (totalWidth / 2f)
            
            for (i in 0 until barCount) {
                val barX = startX + (i * (barWidth + barSpacing))
                val animationOffset = (ringRotation + i * 30f) * kotlin.math.PI / 180f
                val barHeight = (kotlin.math.sin(animationOffset.toDouble()).toFloat().coerceAtLeast(0.1f)) * maxBarHeight
                val barAlpha = glowAlpha * (0.6f + kotlin.math.sin(animationOffset.toDouble()).toFloat() * 0.4f)
                
                // Main bar
                drawRect(
                    color = Color(0xFFFFD700).copy(alpha = barAlpha),
                    topLeft = androidx.compose.ui.geometry.Offset(barX, center.y - (barHeight / 2f)),
                    size = androidx.compose.ui.geometry.Size(barWidth, barHeight)
                )
                
                // Bar glow effect
                drawRect(
                    color = Color(0xFFFFD700).copy(alpha = barAlpha * 0.3f),
                    topLeft = androidx.compose.ui.geometry.Offset(barX - 1f, center.y - (barHeight / 2f) - 1f),
                    size = androidx.compose.ui.geometry.Size(barWidth + 2f, barHeight + 2f)
                )
            }
        }
        
        
        // Shorter hologram beam (avatar is closer now)
        Canvas(
            modifier = Modifier
                .size(280.dp)
                .offset(y = 30.dp)
        ) {
            val center = androidx.compose.ui.geometry.Offset(size.width / 2, size.height / 2)
            
            // Shorter vertical beam effect
            for (i in 0..10) {
                val beamHeight = i * 6f
                val beamAlpha = glowAlpha * (0.2f - i * 0.015f)
                
                if (beamAlpha > 0) {
                    drawLine(
                        color = Color(0xFFFFD700).copy(alpha = beamAlpha),
                        start = androidx.compose.ui.geometry.Offset(center.x, center.y + 40f),
                        end = androidx.compose.ui.geometry.Offset(center.x, center.y + 40f - beamHeight),
                        strokeWidth = 2f + (i * 0.4f)
                    )
                }
            }
            
            // Fewer beam particles (shorter distance)
            for (i in 0..5) {
                val particleY = center.y + 40f - (i * 12f) + (kotlin.math.sin(((ringRotation + i * 60f) * kotlin.math.PI / 180f).toDouble()) * 4f).toFloat()
                drawCircle(
                    color = Color(0xFFFFD700).copy(alpha = glowAlpha * 0.7f),
                    radius = 2f,
                    center = androidx.compose.ui.geometry.Offset(center.x, particleY)
                )
            }
        }
        
        // Clean Floating Avatar (close to hologram base)
        Box(
            modifier = Modifier
                .size(200.dp)
                .offset(y = (-40).dp), // Much closer to the base
            contentAlignment = Alignment.Center
        ) {
            // Simple hologram glow behind thumbnail
            Card(
                modifier = Modifier
                    .size(190.dp)
                    .alpha(0.3f),
                shape = RoundedCornerShape(16.dp),
                colors = CardDefaults.cardColors(
                    containerColor = Color(0xFFFFD700).copy(alpha = 0.2f)
                )
            ) {}
            
            // Main floating thumbnail (exactly like your reference)
            Card(
                modifier = Modifier
                    .size(170.dp)
                    .shadow(
                        elevation = 20.dp,
                        shape = RoundedCornerShape(16.dp),
                        ambientColor = Color(0xFFFFD700),
                        spotColor = Color(0xFFFFD700)
                    )
                    .offset(
                        x = (kotlin.math.sin((ringRotation * kotlin.math.PI / 180f).toDouble()) * 1f).dp,
                        y = (kotlin.math.cos((ringRotation * kotlin.math.PI / 180f * 0.5f).toDouble()) * 0.5f).dp
                    ),
                shape = RoundedCornerShape(16.dp),
                elevation = CardDefaults.cardElevation(defaultElevation = 15.dp)
            ) {
                AsyncImage(
                    model = thumbnailUrl,
                    contentDescription = "Hologram Avatar",
                    contentScale = ContentScale.Crop,
                    modifier = Modifier
                        .fillMaxSize()
                        .clip(RoundedCornerShape(16.dp))
                        .alpha(0.9f + (glowAlpha * 0.1f))
                )
                
                // Simple hologram overlay (like your reference)
                Box(
                    modifier = Modifier
                        .fillMaxSize()
                        .background(
                            Brush.verticalGradient(
                                colors = listOf(
                                    Color(0xFFFFD700).copy(alpha = 0.1f),
                                    Color.Transparent,
                                    Color(0xFFFFD700).copy(alpha = 0.1f)
                                )
                            )
                        )
                )
                
                // Subtle scan lines
                Canvas(modifier = Modifier.fillMaxSize()) {
                    val lineCount = 6
                    for (i in 0 until lineCount) {
                        val y = (size.height / lineCount) * i + (glowAlpha * 20f)
                        drawLine(
                            color = Color(0xFFFFD700).copy(alpha = glowAlpha * 0.2f),
                            start = androidx.compose.ui.geometry.Offset(0f, y),
                            end = androidx.compose.ui.geometry.Offset(size.width, y),
                            strokeWidth = 0.5f
                        )
                    }
                }
            }
        }
        
        // Floating particles effect
        Canvas(
            modifier = Modifier.size(300.dp)
        ) {
            val particleCount = 8
            for (i in 0 until particleCount) {
                val angle = (i * 360f / particleCount) + (ringRotation * 0.5f)
                val distance = 140f + kotlin.math.sin(((ringRotation + i * 45f) * kotlin.math.PI / 180f).toDouble()).toFloat() * 20f
                
                val x = center.x + kotlin.math.cos((angle * kotlin.math.PI / 180f).toDouble()).toFloat() * distance
                val y = center.y + kotlin.math.sin((angle * kotlin.math.PI / 180f).toDouble()).toFloat() * distance
                
                drawCircle(
                    color = Color(0xFFFFD700).copy(alpha = glowAlpha * 0.8f),
                    radius = 3f,
                    center = androidx.compose.ui.geometry.Offset(x, y)
                )
            }
        }
    }
}

@Composable
fun FallbackAudioEffectsDialog(
    onClose: () -> Unit
) {
    Dialog(
        onDismissRequest = onClose,
        properties = DialogProperties(
            dismissOnBackPress = true,
            dismissOnClickOutside = true
        )
    ) {
        Surface(
            modifier = Modifier
                .fillMaxWidth(0.8f)
                .fillMaxHeight(0.6f),
            shape = RoundedCornerShape(16.dp),
            color = MaterialTheme.colorScheme.surface,
            shadowElevation = 8.dp
        ) {
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(24.dp),
                horizontalAlignment = Alignment.CenterHorizontally,
                verticalArrangement = Arrangement.Center
            ) {
                Icon(
                    painter = painterResource(R.drawable.equalizer),
                    contentDescription = null,
                    modifier = Modifier.size(48.dp),
                    tint = MaterialTheme.colorScheme.primary
                )
                
                Spacer(Modifier.height(16.dp))
                
                Text(
                    text = "Audio Effects",
                    style = MaterialTheme.typography.headlineMedium,
                    fontWeight = FontWeight.Bold
                )
                
                Spacer(Modifier.height(8.dp))
                
                Text(
                    text = "Audio effects are temporarily unavailable. Please try again later.",
                    style = MaterialTheme.typography.bodyMedium,
                    textAlign = androidx.compose.ui.text.style.TextAlign.Center
                )
                
                Spacer(Modifier.height(24.dp))
                
                Button(
                    onClick = onClose,
                    modifier = Modifier.fillMaxWidth()
                ) {
                    Text("Close")
                }
            }
        }
    }
}

@Composable
fun SimpleAudioEffectsDialog(
    bassBoost: Float,
    onBassBoostChange: (Float) -> Unit,
    is3DEnabled: Boolean,
    on3DToggle: (Boolean) -> Unit,
    reverbEnabled: Boolean,
    onReverbToggle: (Boolean) -> Unit,
    bassLevel: Float,
    onBassLevelChange: (Float) -> Unit,
    midLevel: Float,
    onMidLevelChange: (Float) -> Unit,
    trebleLevel: Float,
    onTrebleLevelChange: (Float) -> Unit,
    loudnessGain: Float,
    onLoudnessGainChange: (Float) -> Unit,
    echoStrength: Float,
    onEchoStrengthChange: (Float) -> Unit,
    onResetAll: () -> Unit,
    onClose: () -> Unit
) {
    Dialog(
        onDismissRequest = onClose,
        properties = DialogProperties(
            dismissOnBackPress = true,
            dismissOnClickOutside = true,
            usePlatformDefaultWidth = false
        )
    ) {
        Surface(
            modifier = Modifier
                .fillMaxWidth(0.95f)
                .fillMaxHeight(0.85f),
            shape = RoundedCornerShape(16.dp),
            color = MaterialTheme.colorScheme.surface,
            shadowElevation = 8.dp
        ) {
            Column(
                modifier = Modifier
                    .fillMaxSize()
                    .padding(16.dp),
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                // Header
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.SpaceBetween,
                    verticalAlignment = Alignment.CenterVertically
                ) {
                    Text(
                        text = "Audio Effects",
                        style = MaterialTheme.typography.headlineMedium,
                        fontWeight = FontWeight.Bold
                    )
                    IconButton(onClick = onClose) {
                        Icon(
                            painter = painterResource(R.drawable.close),
                            contentDescription = "Close"
                        )
                    }
                }

                // Scrollable content
                Column(
                    modifier = Modifier
                        .weight(1f)
                        .verticalScroll(rememberScrollState()),
                    verticalArrangement = Arrangement.spacedBy(16.dp)
                ) {
                    // Bass Boost
                    AudioEffectSlider(
                        title = "Bass Boost",
                        value = bassBoost,
                        onValueChange = onBassBoostChange,
                        valueRange = 0f..100f,
                        unit = "%"
                    )

                    // 3D Effect Toggle
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            text = "3D Effect",
                            style = MaterialTheme.typography.titleMedium
                        )
                        Switch(
                            checked = is3DEnabled,
                            onCheckedChange = on3DToggle
                        )
                    }

                    // Reverb Toggle
                    Row(
                        modifier = Modifier.fillMaxWidth(),
                        horizontalArrangement = Arrangement.SpaceBetween,
                        verticalAlignment = Alignment.CenterVertically
                    ) {
                        Text(
                            text = "Reverb",
                            style = MaterialTheme.typography.titleMedium
                        )
                        Switch(
                            checked = reverbEnabled,
                            onCheckedChange = onReverbToggle
                        )
                    }

                    // Equalizer Section
                    Text(
                        text = "Equalizer",
                        style = MaterialTheme.typography.titleLarge,
                        fontWeight = FontWeight.Bold
                    )

                    // Bass Level
                    AudioEffectSlider(
                        title = "Bass (60 Hz)",
                        value = bassLevel,
                        onValueChange = onBassLevelChange,
                        valueRange = 0f..100f,
                        unit = "%"
                    )

                    // Mid Level
                    AudioEffectSlider(
                        title = "Mid (1 kHz)",
                        value = midLevel,
                        onValueChange = onMidLevelChange,
                        valueRange = 0f..100f,
                        unit = "%"
                    )

                    // Treble Level
                    AudioEffectSlider(
                        title = "Treble (14 kHz)",
                        value = trebleLevel,
                        onValueChange = onTrebleLevelChange,
                        valueRange = 0f..100f,
                        unit = "%"
                    )

                    // Loudness Gain
                    AudioEffectSlider(
                        title = "Loudness Boost",
                        value = loudnessGain,
                        onValueChange = onLoudnessGainChange,
                        valueRange = 0f..100f,
                        unit = "%"
                    )

                    // Echo Strength
                    AudioEffectSlider(
                        title = "Echo",
                        value = echoStrength,
                        onValueChange = onEchoStrengthChange,
                        valueRange = 0f..100f,
                        unit = "%"
                    )
                }

                // Bottom buttons
                Row(
                    modifier = Modifier.fillMaxWidth(),
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    OutlinedButton(
                        onClick = onResetAll,
                        modifier = Modifier.weight(1f)
                    ) {
                        Text("Reset All")
                    }
                    Button(
                        onClick = onClose,
                        modifier = Modifier.weight(1f)
                    ) {
                        Text("Done")
                    }
                }
            }
        }
    }
}

@Composable
fun AnimatedProgressBar(
    value: Float,
    valueRange: ClosedFloatingPointRange<Float>,
    onValueChange: (Float) -> Unit,
    modifier: Modifier = Modifier,
    isPlaying: Boolean = false
) {
    val infiniteTransition = rememberInfiniteTransition(label = "progress_animation")
    val animatedProgress = infiniteTransition.animateFloat(
        initialValue = 0f,
        targetValue = 1f,
        animationSpec = infiniteRepeatable(
            animation = tween(2000, easing = LinearEasing),
            repeatMode = RepeatMode.Restart
        ),
        label = "progress_glow"
    )

    val progress = (value - valueRange.start) / (valueRange.endInclusive - valueRange.start)
    val progressWidth = progress.coerceIn(0f, 1f)

    Box(
        modifier = modifier
            .height(6.dp)
            .fillMaxWidth()
            .background(
                color = Color.White.copy(alpha = 0.3f),
                shape = RoundedCornerShape(3.dp)
            )
    ) {
        // Animated progress track with glow effect
        Box(
            modifier = Modifier
                .fillMaxHeight()
                .fillMaxWidth(progressWidth)
                .background(
                    brush = Brush.horizontalGradient(
                        colors = listOf(
                            MaterialTheme.colorScheme.primary.copy(alpha = 0.8f),
                            MaterialTheme.colorScheme.primary,
                            MaterialTheme.colorScheme.primary.copy(alpha = 0.8f)
                        ),
                        startX = 0f,
                        endX = Float.POSITIVE_INFINITY
                    ),
                    shape = RoundedCornerShape(3.dp)
                )
        )

        // Glowing animation overlay
        if (isPlaying) {
            Box(
                modifier = Modifier
                    .fillMaxHeight()
                    .width(20.dp)
                    .offset(x = (progressWidth * 300f).dp - 10.dp)
                    .background(
                        brush = Brush.horizontalGradient(
                            colors = listOf(
                                Color.Transparent,
                                Color.White.copy(alpha = 0.6f),
                                Color.Transparent
                            ),
                            startX = 0f,
                            endX = Float.POSITIVE_INFINITY
                        ),
                        shape = RoundedCornerShape(3.dp)
                    )
            )
        }
    }
}
