<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- Liquid Glass Theme - Glassmorphic with Neon -->
    <style name="Theme.OpenTune.LiquidGlass" parent="android:Theme.Material.NoActionBar">
        <!-- Window -->
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/liquid_background</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        
        <!-- Material Colors -->
        <item name="android:colorPrimary">@color/liquid_primary</item>
        <item name="android:colorPrimaryDark">@color/liquid_primary_variant</item>
        <item name="android:colorAccent">@color/liquid_accent</item>
        
        <item name="android:colorBackground">@color/liquid_background</item>
        <item name="android:textColorPrimary">@color/liquid_on_background</item>
        <item name="android:textColorSecondary">@color/liquid_on_surface_variant</item>
    </style>
    
</resources>
