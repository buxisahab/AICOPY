<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 
      LAYER 1: SHADOW AURA
      Provides the "Lift" to make the rod float above the UI.
      Soft, diffused shadow underneath.
    -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="-2dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#20000000"
                android:endColor="#40000000"
                android:centerY="0.5" />
        </shape>
    </item>

    <!-- 
      LAYER 2: THE GLASS CONTAINER BODY (Base Tint + Volume)
      The core "glass" material. 
      Uses a complex gradient to simulate cylinder volume (Fresnel Effect):
      - Top: Slightly milky (glass thickness)
      - Center: ultra-transparent (looking through the rod)
      - Bottom: Slightly milky again
    -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <!-- Crystal Clear Blue-White Tint (#0DFFFFFF = ~5% opacity) -->
            <solid android:color="#0DFFFFFF"/> 
            
            <!-- Volume Gradient: Darker edges to simulate curvature -->
            <gradient
                android:type="linear"
                android:angle="90" 
                android:startColor="#1AECF0F1" 
                android:centerColor="#05FFFFFF"
                android:endColor="#1AECF0F1" />
                
            <!-- Very subtle glassy rim -->
            <stroke android:width="1dp" android:color="#1AFFFFFF"/>
        </shape>
    </item>

    <!-- 
      LAYER 3: TOP SPECULAR HIGHLIGHT (The "Wet" Shine)
      CRITICAL: Creates the illusion of a wet, glossy surface.
      - Sharp start at top, fades quickly.
      - Inset slightly from sides to show curvature.
    -->
    <item android:bottom="32dp" android:left="4dp" android:right="4dp" android:top="1dp">
        <shape android:shape="rectangle">
            <!-- Top corners sharp-ish, bottom diffuse -->
            <corners 
                android:topLeftRadius="100dp" 
                android:topRightRadius="100dp"
                android:bottomLeftRadius="25dp"
                android:bottomRightRadius="25dp"/>
            
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#B3FFFFFF"
                android:endColor="#00FFFFFF" 
                android:centerY="0.7"/> <!-- Intense white fading to clear -->
        </shape>
    </item>

    <!-- 
      LAYER 4: BOTTOM SECONDARY REFLECTION
      Simulates light catching the bottom curve of the glass rod.
      Softer and wider than the top highlight.
    -->
    <item android:top="40dp" android:left="6dp" android:right="6dp" android:bottom="2dp">
        <shape android:shape="rectangle">
             <corners 
                android:bottomLeftRadius="100dp" 
                android:bottomRightRadius="100dp"/>
            
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#40FFFFFF" 
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    
    <!-- 
        LAYER 5: INNER REFRACTION LINE (Optional)
        A faint horizontal streak in the middle to emphasize solid glass nature
    -->
    <item android:top="30dp" android:bottom="30dp" android:left="50dp" android:right="50dp">
         <shape android:shape="rectangle">
            <corners android:radius="50dp"/>
            <gradient 
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#20FFFFFF"
                android:endColor="#00FFFFFF"/>
         </shape>
    </item>

</layer-list>
