<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Liquid Glass Base -->
    <item>
        <shape>
            <!-- 25% White Transparency - Pure Glass Look -->
            <solid android:color="#40FFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Subtle Blur Gradient Overlay -->
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#20FFFFFF"
                android:endColor="#05FFFFFF"
                android:type="linear" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Glossy Highlight (Top-Left Reflection) -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="#50FFFFFF" /> <!-- Subtle White Outline -->
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
