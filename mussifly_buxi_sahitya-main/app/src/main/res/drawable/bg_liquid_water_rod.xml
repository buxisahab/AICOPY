<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. The "Lens" Volume Effect -->
    <!-- Simulates the 3D cylindrical body containing water -->
    <!-- Center is clear/lighter, Top and Bottom are slightly darker (Fresnel effect) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#20ECF0F1"
                android:centerColor="#05ECF0F1"
                android:endColor="#20ECF0F1"
                android:centerY="0.5" />
            
            <!-- Subtle bluish tint for "Crystal Clear Water" look (#1AECF0F1) -->
            <solid android:color="#1AECF0F1"/>
            
            <stroke
                android:width="1dp"
                android:color="#30FFFFFF" /> <!-- Subtle glass rim stroke -->
        </shape>
    </item>

    <!-- 2. The "Wet" Surface (Top Gloss) -->
    <!-- Sharp specular highlight on the top 30% of the rod -->
    <item android:bottom="35dp"> <!-- Inset from bottom to keep it at the top -->
        <shape android:shape="rectangle">
            <corners 
                android:topLeftRadius="100dp"
                android:topRightRadius="100dp"
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp"/> <!-- Soften bottom of highlight -->
            
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#90FFFFFF" 
                android:endColor="#00FFFFFF" /> 
        </shape>
    </item>

    <!-- 3. Secondary Bottom Reflection -->
    <!-- Subtle glow at the bottom edge -->
    <item android:top="40dp"> <!-- Inset from top -->
        <shape android:shape="rectangle">
            <corners 
                android:bottomLeftRadius="100dp"
                android:bottomRightRadius="100dp"/>
            
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#40FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>
