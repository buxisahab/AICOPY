<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape>
            <solid android:color="#40222222" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#50FFFFFF"/>
        </shape>
    </item>

    <!-- Album Art (Left) -->
    <item android:left="12dp" android:width="32dp" android:height="32dp" android:gravity="center_vertical|start">
        <shape android:shape="oval">
            <gradient android:startColor="#FF03DAC5" android:endColor="#FF018786" android:angle="45"/>
        </shape>
    </item>
    
    <!-- Title Line -->
    <item android:left="56dp" android:top="14dp" android:height="6dp" android:width="80dp" android:gravity="top|start">
         <shape>
             <solid android:color="#D0FFFFFF"/>
             <corners android:radius="3dp"/>
         </shape>
    </item>
    
    <!-- Controls (Right): Play Button Mockup -->
    <item android:right="16dp" android:width="24dp" android:height="24dp" android:gravity="center_vertical|end">
        <shape android:shape="oval">
             <solid android:color="#FFFFFF"/>
        </shape>
    </item>
    
     <!-- Controls (Right): Play Triangle -->
    <item android:right="22dp" android:width="10dp" android:height="12dp" android:gravity="center_vertical|end">
        <rotate android:fromDegrees="90" android:toDegrees="90">
             <shape android:shape="line"> 
                  <!-- Hard to draw triangle in pure XML without vector, using a small accent instead -->
             </shape>
        </rotate>
    </item>

</layer-list>
