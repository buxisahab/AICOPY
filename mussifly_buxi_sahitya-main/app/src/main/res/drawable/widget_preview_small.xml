<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape>
            <solid android:color="#40222222" /> <!-- Dark semi-transparent for preview visibility on light/dark bg -->
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#50FFFFFF"/>
        </shape>
    </item>

    <!-- Album Art Placeholder (Circle) -->
    <item android:top="16dp" android:bottom="40dp" android:width="54dp" android:height="54dp" android:gravity="center_horizontal|top">
        <shape android:shape="oval">
            <solid android:color="#FF6200EE" /> <!-- Purple accent -->
            <gradient android:startColor="#FFBB86FC" android:endColor="#FF6200EE" android:angle="45"/>
        </shape>
    </item>
    
    <!-- Title Line -->
    <item android:top="76dp" android:height="6dp" android:width="60dp" android:gravity="center_horizontal|top">
         <shape>
             <solid android:color="#D0FFFFFF"/>
             <corners android:radius="3dp"/>
         </shape>
    </item>

    <!-- Artist Line -->
    <item android:top="86dp" android:height="4dp" android:width="40dp" android:gravity="center_horizontal|top">
         <shape>
             <solid android:color="#80FFFFFF"/>
             <corners android:radius="2dp"/>
         </shape>
    </item>

</layer-list>
